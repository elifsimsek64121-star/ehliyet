/// Levhanın görsel formunu belirler. Gerçek görsel/ikon dosyası
/// kullanmadan, şekil + renk + ikon kombinasyonuyla tanınabilir
/// bir levha çizilir.
enum SignShape {
  triangle,        // Tehlike uyarı: beyaz zemin, kırmızı kenarlı üçgen
  invertedTriangle, // Yol ver: baş aşağı üçgen
  octagon,          // Dur: kırmızı zemin, sekizgen
  circleRed,        // Yasaklama/tanzim: beyaz zemin, kırmızı kalın çerçeve
  circleBlue,       // Mecburi yön / bilgi (dairesel): mavi zemin, beyaz ikon
  squareBlue,       // Bilgi işareti: mavi kare/dikdörtgen zemin
  diamondYellow,    // Geçici/yol çalışması işareti: sarı-turuncu eşkenar dörtgen
}

