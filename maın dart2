class SignQuizScreen extends StatefulWidget {
  final String category;
  final int questionCount;
  const SignQuizScreen({super.key, required this.category, this.questionCount = 10});
  @override
  State<SignQuizScreen> createState() => _SignQuizScreenState();
}

class _SignQuizScreenState extends State<SignQuizScreen> {
  late final List<TrafficSign> _pool;
  late final List<_SignQuestion> _questions;
  int _index = 0;
  int? _selected;
  bool _answered = false;
  int _correct = 0;

  @override
  void initState() {
    super.initState();
    _pool = TrafficSignBank.forCategory(widget.category);
    _questions = _buildQuestions();
  }

  List<_SignQuestion> _buildQuestions() {
    final rnd = Random();
    final shuffledPool = List<TrafficSign>.from(_pool)..shuffle(rnd);
    final count = min(widget.questionCount, shuffledPool.length);
    final chosen = shuffledPool.sublist(0, count);
    return chosen.map((sign) {
      final distractors = List<TrafficSign>.from(_pool)
        ..remove(sign)
        ..shuffle(rnd);
      final wrongOptions = distractors.take(3).map((s) => s.name).toList();
      final options = [sign.name, ...wrongOptions]..shuffle(rnd);
      // az levha varsa 2-3 seçenekle devam edilebilir
      return _SignQuestion(sign: sign, options: options, correctText: sign.name);
    }).toList();
  }

  void _select(int i) {
    if (_answered) return;
    HapticFeedback.selectionClick();
    setState(() {
      _selected = i;
      _answered = true;
      if (_questions[_index].options[i] == _questions[_index].correctText) {
        _correct++;
        SignProgressStore.setKnown(_questions[_index].sign.id, true);
      } else {
        SignProgressStore.setKnown(_questions[_index].sign.id, false);
      }
    });
  }

  void _next() {
    if (_index >= _questions.length - 1) {
      Navigator.of(context).pushReplacement(MaterialPageRoute(
        builder: (_) => _SignQuizResultScreen(
          correct: _correct, total: _questions.length, category: widget.category,
        ),
      ));
      return;
    }
    setState(() {
      _index++;
      _selected = null;
      _answered = false;
    });
  }

  @override
  Widget build(BuildContext context) {
    final isDark = Theme.of(context).brightness == Brightness.dark;

    if (_questions.isEmpty) {
      return Scaffold(
        appBar: AppBar(title: const Text('Mini Test'), backgroundColor: kCardElevated, foregroundColor: Colors.white),
        body: Center(child: Text('Bu kategoride yeterli levha yok.', style: ts(size: 13, color: isDark ? Colors.white54 : Colors.black45))),
      );
    }

    final q = _questions[_index];
    return Scaffold(
      backgroundColor: isDark ? kSurface : const Color(0xFFF4F5F8),
      appBar: AppBar(
        title: Text('${kSignCategoryTitles[widget.category]} · Mini Test', style: ts(size: 14.5, w: FontWeight.w700, color: Colors.white)),
        backgroundColor: kCardElevated,
        foregroundColor: Colors.white,
        elevation: 0,
      ),
      body: Column(children: [
        LinearProgressIndicator(
          value: (_index + 1) / _questions.length,
          minHeight: 4,
          backgroundColor: isDark ? kCardElevated : const Color(0xFFE8EAED),
          valueColor: const AlwaysStoppedAnimation<Color>(kPrimary),
        ),
        Expanded(
          child: ListView(
            padding: const EdgeInsets.all(18),
            children: [
              Text('${_index + 1} / ${_questions.length}', style: ts(size: 12, color: isDark ? Colors.white54 : Colors.black45)),
              const SizedBox(height: 10),
              Center(child: TrafficSignBadge(sign: q.sign, size: 130)),
              const SizedBox(height: 6),
              Center(
                child: Text('Bu levhanın anlamı nedir?',
                    style: ts(size: 14, w: FontWeight.w700, color: isDark ? Colors.white : Colors.black87)),
              ),
              const SizedBox(height: 18),
              ...List.generate(q.options.length, (i) {
                OptionState state = OptionState.idle;
                if (_answered) {
                  if (q.options[i] == q.correctText) {
                    state = OptionState.correct;
                  } else if (i == _selected) {
                    state = OptionState.wrong;
                  }
                } else if (_selected == i) {
                  state = OptionState.selected;
                }
                return OptionTile(
                  label: String.fromCharCode(65 + i),
                  text: q.options[i],
                  state: state,
                  isDark: isDark,
                  onTap: () => _select(i),
                );
              }),
            ],
          ),
        ),
        Padding(
          padding: const EdgeInsets.fromLTRB(18, 4, 18, 18),
          child: SizedBox(
            width: double.infinity,
            child: ElevatedButton(
              onPressed: _answered ? _next : null,
              child: Text(_index >= _questions.length - 1 ? 'BİTİR' : 'SONRAKİ',
                  style: ts(size: 14.5, w: FontWeight.w800, color: kSurface)),
            ),
          ),
        ),
      ]),
    );
  }
}

class _SignQuestion {
  final TrafficSign sign;
  final List<String> options;
  final String correctText;
  _SignQuestion({required this.sign, required this.options, required this.correctText});
}

class _SignQuizResultScreen extends StatelessWidget {
  final int correct;
  final int total;
  final String category;
  const _SignQuizResultScreen({required this.correct, required this.total, required this.category});

  @override
  Widget build(BuildContext context) {
    final isDark = Theme.of(context).brightness == Brightness.dark;
    final pct = total == 0 ? 0.0 : (correct / total) * 100;
    final color = pct >= 70 ? kSuccess : kDanger;

    return Scaffold(
      backgroundColor: isDark ? kSurface : const Color(0xFFF4F5F8),
      appBar: AppBar(
        title: const Text('Test Sonucu'),
        backgroundColor: kCardElevated,
        foregroundColor: Colors.white,
        elevation: 0,
        automaticallyImplyLeading: false,
      ),
      bottomNavigationBar: const BannerAdWidget(),
      body: Center(
        child: Padding(
          padding: const EdgeInsets.all(24),
          child: Column(mainAxisSize: MainAxisSize.min, children: [
            Icon(pct >= 70 ? Icons.emoji_events_rounded : Icons.replay_circle_filled_rounded, color: color, size: 48),
            const SizedBox(height: 14),
            Text('${pct.toStringAsFixed(0)}%', style: tsD(size: 44, w: FontWeight.w800, color: color)),
            const SizedBox(height: 8),
            Text('$correct / $total doğru', style: ts(size: 14, color: isDark ? Colors.white70 : Colors.black54)),
            const SizedBox(height: 22),
            Row(mainAxisSize: MainAxisSize.min, children: [
              OutlinedButton(
                onPressed: () => Navigator.of(context).pop(),
                child: const Text('GERİ DÖN'),
              ),
              const SizedBox(width: 10),
              ElevatedButton(
                onPressed: () => Navigator.of(context).pushReplacement(MaterialPageRoute(
                  builder: (_) => SignQuizScreen(category: category),
                )),
                child: const Text('TEKRAR ÇÖZ'),
              ),
            ]),
          ]),
        ),
      ),
    );
  }
}
