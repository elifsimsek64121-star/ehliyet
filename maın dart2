        text: 'Düşük hızlarda sürüş yakıt tüketimini nasıl etkiler?',
        opts: ['Artırır', 'Değiştirmez', 'Çok azaltır', 'Motorun verimli çalıştığı aralığa bağlıdır'],
        explanation: 'En düşük yakıt tüketimi genellikle 80-90 km/h aralığında gerçekleşir; bu altı ve üstünde tüketim artar.',
      ),
      Q(
        id: 'CE05',
        cat: Cat.cevresel,
        correct: 1,
        text: 'Motor rölantide (boşta) çalıştırmanın çevreye etkisi nedir?',
        opts: ['Olumlu etki', 'Gereksiz emisyon ve yakıt israfı', 'Motoru korur', 'Yağı ısıtır, iyidir'],
        explanation:
            'Modern araçlarda uzun süreli rölanti gereksiz yakıt harcar ve emisyon üretir; modern motorlar hemen çalışabilir.',
      ),
      Q(
        id: 'CE06',
        cat: Cat.cevresel,
        correct: 2,
        text: 'Elektrikli araçlar şehir içinde çevresel avantaj sağlar çünkü:',
        opts: ['Daha hızlıdır', 'Daha ucuzdur', 'Egzoz emisyonu yoktur', 'Bakım gerektirmez'],
        explanation: 'Elektrikli araçlar şehir içinde egzoz gazı üretmez; böylece hava kalitesine doğrudan katkı sağlar.',
      ),
      Q(
        id: 'CE07',
        cat: Cat.cevresel,
        correct: 0,
        text: 'Araç kliması kapatıldığında yakıt tüketimine etkisi nedir?',
        opts: ['%5-15 oranında azalır', 'Artış olur', 'Değişmez', '%30 azalır'],
        explanation: 'Klima kompresörü yaklaşık %5-15 oranında ek yakıt tüketimine yol açar; kapatmak tasarruf sağlar.',
      ),
    ];
  }

  static List<Q> byCat(Cat c) => all.where((q) => q.cat == c).toList();
  static List<Q> random(int n) {
    final list = List<Q>.from(all)..shuffle(Random());
    return list.take(n.clamp(0, list.length)).toList();
  }

  static List<Q> exam() {
    // Real exam: 50 questions distributed across categories
    final result = <Q>[];
    final targets = {
      Cat.trafik: 14,
      Cat.ilkYardim: 8,
      Cat.motor: 8,
      Cat.trafikAdabi: 6,
      Cat.levhalar: 6,
      Cat.aracTeknik: 5,
      Cat.ceza: 3,
      Cat.cevresel: 3,
    };
    for (final cat in Cat.values) {
      final qs = byCat(cat)..shuffle(Random());
      result.addAll(qs.take(targets[cat] ?? 2));
    }
    result.shuffle(Random());
    return result;
  }
}

