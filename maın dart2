TextStyle ts({
  double size = 13,
  FontWeight w = FontWeight.normal,
  Color color = C.txt,
  double? height,
}) => TextStyle(fontSize: size, fontWeight: w, color: color, height: height);

TextStyle tsD({
  double size = 16,
  FontWeight w = FontWeight.w700,
  Color color = C.txt,
  double? height,
}) => TextStyle(
  fontSize: size,
  fontWeight: w,
  color: color,
  height: height,
  letterSpacing: -0.2,
);

