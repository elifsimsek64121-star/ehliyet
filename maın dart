class _SignFlashcardScreenState extends State<SignFlashcardScreen> {
  int _index = 0;
  bool _flipped = false;
  int _knownCount = 0;
  int _unknownCount = 0;

  TrafficSign get _current => widget.signs[_index];
  bool get _done => _index >= widget.signs.length;

  Future<void> _mark(bool known) async {
    await SignProgressStore.setKnown(_current.id, known);
    setState(() {
      if (known) {
        _knownCount++;
      } else {
        _unknownCount++;
      }
      _index++;
      _flipped = false;
    });
