/// Gerçek AdMob banner reklamını yükleyip gösteren widget.
/// Premium kullanıcılar için otomatik olarak hiçbir alan kaplamaz.
class BannerAdWidget extends StatefulWidget {
  const BannerAdWidget({super.key});
  @override
  State<BannerAdWidget> createState() => _BannerAdWidgetState();
}

class _BannerAdWidgetState extends State<BannerAdWidget> {
  BannerAd? _bannerAd;
  bool _isLoaded = false;

  @override
  void initState() {
    super.initState();
    if (!AdManager.instance.isPremium) {
      _loadAd();
    }
  }

  void _loadAd() {
    try {
      _bannerAd = BannerAd(
        adUnitId: AdIds.banner,
        size: AdSize.banner,
        request: const AdRequest(),
        listener: BannerAdListener(
          onAdLoaded: (ad) {
            if (!mounted) {
              ad.dispose();
              return;
            }
            setState(() => _isLoaded = true);
          },
          onAdFailedToLoad: (ad, error) {
            ad.dispose();
            if (mounted) setState(() => _isLoaded = false);
          },
        ),
      );
      _bannerAd!.load();
    } catch (_) {
      // Reklam SDK'sı ile ilgili beklenmeyen bir sorun uygulamayı
      // çökertmesin; banner sadece görünmez kalır.
      _isLoaded = false;
    }
  }

  @override
  void dispose() {
    _bannerAd?.dispose();
    super.dispose();
  }

  @override
  Widget build(BuildContext context) {
    if (AdManager.instance.isPremium || !_isLoaded || _bannerAd == null) {
      return const SizedBox.shrink();
    }
    return SafeArea(
      top: false,
      child: Container(
        width: _bannerAd!.size.width.toDouble(),
        height: _bannerAd!.size.height.toDouble(),
        alignment: Alignment.center,
        color: C.surface,
        child: AdWidget(ad: _bannerAd!),
      ),
    );
  }
}

/// AdMob "Yerel Gelişmiş" (Native Advanced) reklam kartı.
///
/// ÖNEMLİ / ÇÖKME DÜZELTMESİ:
/// Native reklamların Flutter tarafında gösterilebilmesi için Android/iOS
/// projelerinde bir NativeAdFactory kaydı (factoryId: 'listTileNativeAdFactory')
/// yapılması GEREKİR. Bu proje yalnızca main.dart olarak paylaşıldığı ve bu
/// native kayıt tamamlanmadığı sürece, bu widget'ın gerçek native reklamı
/// yüklemeye/render etmeye çalışması uygulamanın (özellikle Android'de)
/// "kayıtsız platform view" hatasıyla ANINDA KAPANMASINA sebep olur.
///
/// Bu yüzden, native reklam denemesi şimdilik güvenli şekilde devre dışı
/// bırakılmıştır; widget hiçbir şey render etmez ve uygulama çökmez.
/// Native reklamı native tarafta (Android: MainActivity/Application içinde
/// GoogleMobileAdsPlugin.registerNativeAdFactory, iOS: AppDelegate içinde
/// FLTGoogleMobileAdsPlugin.registerNativeAdFactory) kayıt ettikten sonra
/// aşağıdaki `_nativeAdsEnabled` sabitini `true` yapabilirsiniz.
class NativeAdCard extends StatefulWidget {
  const NativeAdCard({super.key});
  @override
  State<NativeAdCard> createState() => _NativeAdCardState();
}

class _NativeAdCardState extends State<NativeAdCard> {
  // Native reklam fabrikası (factoryId) native tarafta kayıtlı OLMADAN bu
  // değeri true yapmayın — aksi halde uygulama çöker.
  static const bool _nativeAdsEnabled = false;

  NativeAd? _nativeAd;
  bool _isLoaded = false;

  @override
  void initState() {
    super.initState();
    if (_nativeAdsEnabled && !AdManager.instance.isPremium) {
      _loadAd();
    }
  }

  void _loadAd() {
    try {
      _nativeAd = NativeAd(
        adUnitId: AdIds.native,
        request: const AdRequest(),
        factoryId: 'listTileNativeAdFactory',
        listener: NativeAdListener(
          onAdLoaded: (ad) {
            if (!mounted) {
              ad.dispose();
              return;
            }
            setState(() => _isLoaded = true);
          },
          onAdFailedToLoad: (ad, error) {
            ad.dispose();
            if (mounted) setState(() => _isLoaded = false);
          },
        ),
      );
      _nativeAd!.load();
    } catch (_) {
      // Native fabrika kayıtlı değilse burada da güvenli şekilde vazgeçilir.
      _isLoaded = false;
    }
  }

  @override
  void dispose() {
    _nativeAd?.dispose();
    super.dispose();
  }

  @override
  Widget build(BuildContext context) {
    if (!_nativeAdsEnabled ||
        AdManager.instance.isPremium ||
        !_isLoaded ||
        _nativeAd == null) {
      return const SizedBox.shrink();
    }
    return Container(
      height: 120,
      margin: const EdgeInsets.only(bottom: 4),
      decoration: BoxDecoration(
        color: C.card,
        borderRadius: BorderRadius.circular(16),
        border: Border.all(color: C.border),
      ),
      clipBehavior: Clip.antiAlias,
      child: AdWidget(ad: _nativeAd!),
    );
  }
}

enum OptionState { idle, selected, correct, wrong }

class OptionTile extends StatelessWidget {
  final String label;
  final String text;
  final OptionState state;
  final bool isDark;
  final VoidCallback onTap;
  const OptionTile({
    super.key,
    required this.label,
    required this.text,
    required this.state,
    required this.isDark,
    required this.onTap,
  });

  Color get _bg {
    switch (state) {
      case OptionState.correct:
        return kSuccess.withOpacity(.18);
      case OptionState.wrong:
        return kDanger.withOpacity(.18);
      case OptionState.selected:
        return kPrimary.withOpacity(.18);
      case OptionState.idle:
        return isDark ? kCardDark : Colors.white;
    }
  }

  Color get _border {
    switch (state) {
      case OptionState.correct:
        return kSuccess;
      case OptionState.wrong:
        return kDanger;
      case OptionState.selected:
        return kPrimary;
      case OptionState.idle:
        return isDark ? kBorderDark : const Color(0xFFE4E6EC);
    }
  }

  @override
  Widget build(BuildContext context) => Padding(
    padding: const EdgeInsets.only(bottom: 10),
    child: GestureDetector(
      onTap: onTap,
      child: AnimatedContainer(
        duration: const Duration(milliseconds: 200),
        padding: const EdgeInsets.symmetric(horizontal: 14, vertical: 14),
        decoration: BoxDecoration(
          color: _bg,
          borderRadius: BorderRadius.circular(14),
          border: Border.all(color: _border, width: 1.6),
        ),
        child: Row(
          children: [
            Container(
              width: 28,
              height: 28,
              decoration: BoxDecoration(
                shape: BoxShape.circle,
                color: _border.withOpacity(.15),
              ),
              child: Center(
                child: Text(
                  label,
                  style: ts(size: 12, w: FontWeight.w800, color: _border),
                ),
              ),
            ),
            const SizedBox(width: 12),
            Expanded(
              child: Text(
                text,
                style: ts(
                  size: 13.5,
                  w: FontWeight.w600,
                  color: isDark ? Colors.white : Colors.black87,
                ),
              ),
            ),
            if (state == OptionState.correct)
              const Icon(Icons.check_circle_rounded, color: kSuccess, size: 20),
            if (state == OptionState.wrong)
              const Icon(Icons.cancel_rounded, color: kDanger, size: 20),
          ],
        ),
      ),
    ),
  );
}
