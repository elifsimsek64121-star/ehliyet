class SignFlashcardScreen extends StatefulWidget {
  final List<TrafficSign> signs;
  final String title;
  const SignFlashcardScreen({super.key, required this.signs, required this.title});
  @override
  State<SignFlashcardScreen> createState() => _SignFlashcardScreenState();
}

class _SignFlashcardScreenState extends State<SignFlashcardScreen> {
  int _index = 0;
  bool _flipped = false;
  int _knownCount = 0;
  int _unknownCount = 0;

  TrafficSign get _current => widget.signs[_index];
  bool get _done => _index >= widget.signs.length;

  Future<void> _mark(bool known) async {
    await SignProgressStore.setKnown(_current.id, known);
    setState(() {
      if (known) {
        _knownCount++;
      } else {
        _unknownCount++;
      }
      _index++;
      _flipped = false;
    });
  }

  @override
  Widget build(BuildContext context) {
    final isDark = Theme.of(context).brightness == Brightness.dark;

    return Scaffold(
      backgroundColor: isDark ? kSurface : const Color(0xFFF4F5F8),
      appBar: AppBar(
        title: Text(widget.title, style: ts(size: 15, w: FontWeight.w700, color: Colors.white)),
        backgroundColor: kCardElevated,
        foregroundColor: Colors.white,
        elevation: 0,
      ),
      bottomNavigationBar: const BannerAdWidget(),
      body: widget.signs.isEmpty
          ? Center(child: Text('Bu sette levha yok.', style: ts(size: 13, color: isDark ? Colors.white54 : Colors.black45)))
          : _done
              ? _summary(isDark)
              : _card(isDark),
    );
  }

  Widget _summary(bool isDark) => Center(
        child: Padding(
          padding: const EdgeInsets.all(24),
          child: Column(mainAxisSize: MainAxisSize.min, children: [
            const Icon(Icons.emoji_events_rounded, color: kPrimary, size: 52),
            const SizedBox(height: 14),
            Text('Tur tamamlandı!', style: tsD(size: 20, w: FontWeight.w800, color: isDark ? Colors.white : Colors.black87)),
            const SizedBox(height: 10),
            Text('✅ Biliyorum: $_knownCount   ❌ Bilmiyorum: $_unknownCount',
                style: ts(size: 14, color: isDark ? Colors.white70 : Colors.black54)),
            const SizedBox(height: 20),
            ElevatedButton(
              onPressed: () => Navigator.of(context).pop(),
              child: const Text('GERİ DÖN'),
            ),
          ]),
        ),
      );

  Widget _card(bool isDark) {
    final s = _current;
    return Padding(
      padding: const EdgeInsets.all(20),
      child: Column(children: [
        LinearProgressIndicator(
          value: _index / widget.signs.length,
          minHeight: 5,
          backgroundColor: isDark ? kCardElevated : const Color(0xFFE8EAED),
          valueColor: const AlwaysStoppedAnimation<Color>(kPrimary),
        ),
        const SizedBox(height: 6),
        Text('${_index + 1} / ${widget.signs.length}', style: ts(size: 12, color: isDark ? Colors.white38 : Colors.black38)),
        Expanded(
          child: Center(
            child: GestureDetector(
              onTap: () => setState(() => _flipped = !_flipped),
              child: AnimatedSwitcher(
                duration: const Duration(milliseconds: 220),
                child: _flipped ? _backFace(isDark, s) : _frontFace(isDark, s),
              ),
            ),
          ),
        ),
        if (!_flipped)
          Padding(
            padding: const EdgeInsets.only(bottom: 8),
            child: Text('Kartı çevirmek için dokun', style: ts(size: 12, color: isDark ? Colors.white38 : Colors.black38)),
          ),
        Row(children: [
          Expanded(
            child: OutlinedButton.icon(
              onPressed: () => _mark(false),
              icon: const Icon(Icons.close_rounded, color: kDanger),
              label: Text('Bilmiyorum', style: ts(size: 13.5, w: FontWeight.w700, color: kDanger)),
              style: OutlinedButton.styleFrom(
                padding: const EdgeInsets.symmetric(vertical: 14),
                side: const BorderSide(color: kDanger),
                shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(12)),
              ),
            ),
          ),
          const SizedBox(width: 10),
          Expanded(
            child: ElevatedButton.icon(
              onPressed: () => _mark(true),
              icon: const Icon(Icons.check_rounded),
              label: Text('Biliyorum', style: ts(size: 13.5, w: FontWeight.w800, color: kSurface)),
              style: ElevatedButton.styleFrom(backgroundColor: kSuccess),
            ),
          ),
        ]),
      ]),
    );
  }

  Widget _frontFace(bool isDark, TrafficSign s) => Container(
        key: const ValueKey('front'),
        width: 240,
        height: 300,
        padding: const EdgeInsets.all(20),
        decoration: BoxDecoration(
          color: isDark ? kCard : Colors.white,
          borderRadius: BorderRadius.circular(20),
          border: Border.all(color: isDark ? kBorder : const Color(0xFFE4E6EC)),
        ),
        alignment: Alignment.center,
        child: Column(mainAxisAlignment: MainAxisAlignment.center, children: [
          TrafficSignBadge(sign: s, size: 130),
          const SizedBox(height: 18),
          Text('Bu levhayı biliyor musun?', textAlign: TextAlign.center,
              style: ts(size: 13, w: FontWeight.w600, color: isDark ? Colors.white54 : Colors.black45)),
        ]),
      );

  Widget _backFace(bool isDark, TrafficSign s) => Container(
        key: const ValueKey('back'),
        width: 240,
        height: 300,
        padding: const EdgeInsets.all(20),
        decoration: BoxDecoration(
          color: isDark ? kCard : Colors.white,
          borderRadius: BorderRadius.circular(20),
          border: Border.all(color: kPrimary, width: 1.6),
        ),
        alignment: Alignment.center,
        child: SingleChildScrollView(
          child: Column(mainAxisAlignment: MainAxisAlignment.center, children: [
            TrafficSignBadge(sign: s, size: 80),
            const SizedBox(height: 12),
            Text(s.name, textAlign: TextAlign.center,
                style: ts(size: 15, w: FontWeight.w800, color: isDark ? Colors.white : Colors.black87)),
            const SizedBox(height: 8),
            Text(s.meaning, textAlign: TextAlign.center,
                style: ts(size: 12, color: isDark ? Colors.white70 : Colors.black54, height: 1.35)),
          ]),
        ),
      );
}

