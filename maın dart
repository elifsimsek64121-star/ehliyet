class QuestionSearchDelegate extends SearchDelegate<Q?> {
  final AppState s;
  QuestionSearchDelegate({required this.s});

  @override
  String get searchFieldLabel => 'Soru veya kelime ara...';

  @override
  List<Widget> buildActions(BuildContext context) => [
        if (query.isNotEmpty)
          IconButton(icon: const Icon(Icons.clear), onPressed: () => query = ''),
      ];

  @override
  Widget buildLeading(BuildContext context) => IconButton(
        icon: const Icon(Icons.arrow_back),
        onPressed: () => close(context, null),
      );

  List<Q> _results() {
    if (query.trim().length < 2) return [];
    final q = query.toLowerCase();
    return QB.all
        .where((e) =>
            e.text.toLowerCase().contains(q) ||
            e.explanation.toLowerCase().contains(q))
        .take(40)
        .toList();
  }

  @override
  Widget buildResults(BuildContext context) => _list(context);

  @override
  Widget buildSuggestions(BuildContext context) => _list(context);

  Widget _list(BuildContext context) {
    final res = _results();
    if (query.trim().length < 2) {
      return const Center(
          child: Text('En az 2 karakter yazın', style: TextStyle(color: C.txt2)));
    }
    if (res.isEmpty) {
      return const Center(
          child: Text('Sonuç bulunamadı', style: TextStyle(color: C.txt2)));
    }
    return Container(
      color: C.bg,
      child: ListView.separated(
        padding: const EdgeInsets.all(12),
        itemCount: res.length,
        separatorBuilder: (_, __) => const SizedBox(height: 8),
        itemBuilder: (_, i) {
          final item = res[i];
          return Material(
            color: C.card,
            borderRadius: BorderRadius.circular(12),
            child: ListTile(
              shape: RoundedRectangleBorder(
                  borderRadius: BorderRadius.circular(12)),
              leading: Icon(item.cat.icon, color: item.cat.color),
              title: Text(item.text,
                  maxLines: 2,
                  overflow: TextOverflow.ellipsis,
                  style: const TextStyle(color: C.txt, fontSize: 13)),
              subtitle: Text(item.cat.label,
                  style: TextStyle(color: item.cat.color, fontSize: 11)),
              onTap: () {
                close(context, item);
                Navigator.push(
                  context,
                  MaterialPageRoute(
                    builder: (_) =>
                        TestScreen(qs: [item], s: s, title: 'Arama Sonucu'),
                  ),
                );
              },
            ),
          );
        },
      ),
    );
  }
}

