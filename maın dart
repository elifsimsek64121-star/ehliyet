enum OptionState { idle, selected, correct, wrong }

class OptionTile extends StatelessWidget {
  final String label; // A, B, C, D
  final String text;
  final OptionState state;
  final bool isDark;
  final VoidCallback? onTap;

  const OptionTile({
    super.key,
    required this.label,
    required this.text,
    required this.state,
    required this.isDark,
    this.onTap,
  });

  @override
  Widget build(BuildContext context) {
    Color border;
    Color bg;
    Color fg;
    switch (state) {
      case OptionState.correct:
        border = kSuccess;
        bg = kSuccess.withAlpha(30);
        fg = kSuccess;
        break;
      case OptionState.wrong:
        border = kDanger;
        bg = kDanger.withAlpha(30);
        fg = kDanger;
        break;
      case OptionState.selected:
        border = kPrimary;
        bg = kPrimary.withAlpha(30);
        fg = kPrimary;
        break;
      case OptionState.idle:
        border = isDark ? kBorder : const Color(0xFFE4E6EC);
        bg = isDark ? kCard : Colors.white;
        fg = isDark ? Colors.white : Colors.black87;
    }

    return GestureDetector(
      onTap: onTap,
      child: AnimatedContainer(
        duration: const Duration(milliseconds: 160),
        margin: const EdgeInsets.only(bottom: 10),
        padding: const EdgeInsets.symmetric(horizontal: 14, vertical: 14),
        decoration: BoxDecoration(
          color: bg,
          borderRadius: BorderRadius.circular(12),
          border: Border.all(color: border, width: state == OptionState.idle ? 1 : 1.6),
        ),
        child: Row(children: [
          Container(
            width: 28,
            height: 28,
            alignment: Alignment.center,
            decoration: BoxDecoration(color: border.withAlpha(40), shape: BoxShape.circle),
            child: Text(label, style: ts(size: 13, w: FontWeight.w800, color: fg)),
          ),
          const SizedBox(width: 12),
          Expanded(
              child: Text(text,
                  style: ts(size: 14, w: FontWeight.w600, color: fg, height: 1.3))),
          if (state == OptionState.correct) const Icon(Icons.check_circle_rounded, color: kSuccess, size: 20),
          if (state == OptionState.wrong) const Icon(Icons.cancel_rounded, color: kDanger, size: 20),
        ]),
      ),
    );
  }
}

