class AnimatedQuestionsScreen extends StatefulWidget {
  final AppState s;
  const AnimatedQuestionsScreen({super.key, required this.s});
  @override
  State<AnimatedQuestionsScreen> createState() => _AnimatedQuestionsScreenState();
}

class _AnimatedQuestionsScreenState extends State<AnimatedQuestionsScreen> {
  int _idx = 0;
  int _step = 0;
  int? _sel;
  bool _answered = false;
  int _correct = 0;
  Timer? _auto;

  AnimatedScenario get cur => kAnimatedScenarios[_idx];
  bool get _stepsDone => _step >= cur.steps.length;

  @override
  void initState() {
    super.initState();
    _startSteps();
  }

  @override
  void dispose() {
    _auto?.cancel();
    super.dispose();
  }

  void _startSteps() {
    _auto?.cancel();
    _step = 0;
    _sel = null;
    _answered = false;
    _auto = Timer.periodic(const Duration(milliseconds: 1400), (t) {
      if (!mounted) {
        t.cancel();
        return;
      }
      if (_step < cur.steps.length) {
        setState(() => _step++);
      } else {
        t.cancel();
      }
    });
  }

  void _select(int i) {
    if (!_stepsDone || _answered) return;
    final ok = i == cur.correct;
    setState(() {
      _sel = i;
      _answered = true;
      if (ok) _correct++;
    });
    widget.s.answer(ok, Cat.trafik, cur.id);
  }

  void _next() {
    if (_idx < kAnimatedScenarios.length - 1) {
      setState(() => _idx++);
      _startSteps();
    } else {
      showModalBottomSheet(
        context: context,
        backgroundColor: Theme.of(context).cardColor,
        shape: const RoundedRectangleBorder(
          borderRadius: BorderRadius.vertical(top: Radius.circular(24)),
        ),
        builder: (_) => Padding(
          padding: const EdgeInsets.all(28),
          child: Column(
            mainAxisSize: MainAxisSize.min,
            children: [
              Text(
                '$_correct / ${kAnimatedScenarios.length} doğru',
                style: const TextStyle(fontSize: 22, fontWeight: FontWeight.w900),
              ),
              const SizedBox(height: 16),
              ElevatedButton(
                onPressed: () {
                  Navigator.pop(context);
                  Navigator.pop(context);
                },
                child: const Text('Tamam'),
              ),
            ],
          ),
        ),
      );
    }
  }

  @override
  Widget build(BuildContext context) {
    final cs = Theme.of(context).colorScheme;
    return Scaffold(
      appBar: AppBar(
        title: Text('Animasyonlu ${_idx + 1}/${kAnimatedScenarios.length}'),
      ),
      bottomNavigationBar: const BannerAdWidget(),
      body: Column(
        children: [
          LinearProgressIndicator(
            value: (_idx + 1) / kAnimatedScenarios.length,
            minHeight: 4,
            backgroundColor: cs.surface,
            valueColor: AlwaysStoppedAnimation(cur.color),
          ),
          Expanded(
            child: ListView(
              padding: const EdgeInsets.all(18),
              children: [
                Row(
                  children: [
                    Container(
                      padding: const EdgeInsets.all(10),
                      decoration: BoxDecoration(
                        color: cur.color.withOpacity(0.12),
                        borderRadius: BorderRadius.circular(12),
                      ),
                      child: Icon(cur.icon, color: cur.color, size: 28),
                    ),
                    const SizedBox(width: 12),
                    Expanded(
                      child: Text(
                        cur.title,
                        style: TextStyle(
                          fontWeight: FontWeight.w800,
                          fontSize: 18,
                          color: cs.onSurface,
                        ),
                      ),
                    ),
                  ],
                ),
                const SizedBox(height: 20),
                ...List.generate(cur.steps.length, (i) {
                  final visible = i < _step;
                  return AnimatedOpacity(
                    duration: const Duration(milliseconds: 400),
                    opacity: visible ? 1 : 0.15,
                    child: Container(
                      margin: const EdgeInsets.only(bottom: 10),
                      padding: const EdgeInsets.all(14),
                      decoration: BoxDecoration(
                        color: visible
                            ? cur.color.withOpacity(0.08)
                            : cs.surface,
                        borderRadius: BorderRadius.circular(14),
                        border: Border.all(
                          color: visible
                              ? cur.color.withOpacity(0.35)
                              : Colors.transparent,
                        ),
                      ),
                      child: Row(
                        children: [
                          CircleAvatar(
                            radius: 14,
                            backgroundColor: visible ? cur.color : cs.onSurface.withOpacity(0.12),
                            child: Text(
                              '${i + 1}',
                              style: TextStyle(
                                color: visible ? Colors.white : cs.onSurface.withOpacity(0.45),
                                fontSize: 12,
                                fontWeight: FontWeight.w800,
                              ),
                            ),
                          ),
                          const SizedBox(width: 12),
                          Expanded(
                            child: Text(
                              cur.steps[i],
                              style: TextStyle(
                                color: cs.onSurface,
                                fontWeight: visible ? FontWeight.w600 : FontWeight.normal,
                              ),
                            ),
                          ),
                        ],
                      ),
                    ),
                  );
                }),
                if (_stepsDone) ...[
                  const SizedBox(height: 12),
                  Text(
                    cur.question,
                    style: TextStyle(
                      fontWeight: FontWeight.w800,
                      fontSize: 16,
                      color: cs.onSurface,
                    ),
                  ),
                  const SizedBox(height: 14),
                  ...List.generate(cur.opts.length, (i) {
                    Color bg = cs.surface;
                    Color border = Colors.transparent;
                    if (_answered) {
                      if (i == cur.correct) {
                        bg = C.ok.withOpacity(0.12);
                        border = C.okLight;
                      } else if (i == _sel) {
                        bg = C.err.withOpacity(0.12);
                        border = C.errLight;
                      }
                    }
                    return Padding(
                      padding: const EdgeInsets.only(bottom: 10),
                      child: GestureDetector(
                        onTap: () => _select(i),
                        child: AnimatedContainer(
                          duration: const Duration(milliseconds: 200),
                          padding: const EdgeInsets.all(14),
                          decoration: BoxDecoration(
                            color: bg,
                            borderRadius: BorderRadius.circular(14),
                            border: Border.all(color: border, width: 2),
                          ),
                          child: Row(
                            children: [
                              Text(
                                String.fromCharCode(65 + i),
                                style: TextStyle(
                                  fontWeight: FontWeight.w900,
                                  color: C.primary,
                                ),
                              ),
                              const SizedBox(width: 12),
                              Expanded(
                                child: Text(
                                  cur.opts[i],
                                  style: TextStyle(color: cs.onSurface),
                                ),
                              ),
                            ],
                          ),
                        ),
                      ),
                    );
                  }),
                  if (_answered) ...[
                    const SizedBox(height: 8),
                    Container(
                      padding: const EdgeInsets.all(14),
                      decoration: BoxDecoration(
                        color: C.primary.withOpacity(0.08),
                        borderRadius: BorderRadius.circular(14),
                      ),
                      child: Text(
                        cur.explanation,
                        style: TextStyle(
                          color: cs.onSurface.withOpacity(0.75),
                          height: 1.4,
                        ),
                      ),
                    ),
                    const SizedBox(height: 16),
                    SizedBox(
                      width: double.infinity,
                      child: ElevatedButton(
                        onPressed: _next,
                        child: Text(
                          _idx < kAnimatedScenarios.length - 1
                              ? 'Sonraki Senaryo'
                              : 'Sonuçları Gör',
                        ),
                      ),
                    ),
                  ],
                ],
              ],
            ),
          ),
        ],
      ),
    );
  }
}

