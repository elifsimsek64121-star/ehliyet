// ══════════════════════════════════════════════════════════════════
//  GOOGLE PLAY BILLING — GERÇEK PREMIUM SATIN ALMA
//  Play Store politikalarına uygun tek yol: dijital içerik/özellik
//  satışı resmi Play Billing Library üzerinden (in_app_purchase paketi)
//  yapılmalıdır. Harici ödeme linki/başka bir ödeme sağlayıcısına
//  yönlendirme veya "ücretsiz demo" adı altında gerçek parayla
//  satılan bir özelliği bedelsiz açmak Play politika ihlalidir.
//  Bu yüzden ürün, Play Console'da tanımlanan gerçek bir "in-app
//  product" (kalıcı/non-consumable) olarak satılır.
// ══════════════════════════════════════════════════════════════════
class BillingIds {
  BillingIds._();

  /// Play Console → Monetize → Products → In-app products altında
  /// BİREBİR AYNI ID ile tanımlanması gereken kalıcı (non-consumable)
  /// premium ürünü. Burada değiştirirseniz Play Console'daki ürün
  /// ID'sini de aynı şekilde güncelleyin.
  static const String premiumLifetime = 'sinav365_premium_lifetime';

  static const Set<String> productIds = {premiumLifetime};
}

class BillingManager {
  BillingManager._();
  static final BillingManager instance = BillingManager._();

  final InAppPurchase _iap = InAppPurchase.instance;
  StreamSubscription<List<PurchaseDetails>>? _sub;

  bool available = false;
  bool purchasePending = false;
  bool storeQueried = false;
  String? lastError;
  ProductDetails? premiumProduct;

  /// Satın alma / restore başarıyla doğrulandığında çağrılır.
  void Function()? _onPremiumUnlocked;

  /// UI'ın (Premium dialog) durum değişikliklerinden haberdar olması için.
  final List<VoidCallback> _listeners = [];
  void addListener(VoidCallback cb) => _listeners.add(cb);
  void removeListener(VoidCallback cb) => _listeners.remove(cb);
  void _notify() {
    for (final cb in List<VoidCallback>.from(_listeners)) {
      cb();
    }
  }

  Future<void> init({required void Function() onPremiumUnlocked}) async {
    _onPremiumUnlocked = onPremiumUnlocked;
    try {
      available = await _iap.isAvailable();
    } catch (_) {
      available = false;
    }
    if (!available) {
      storeQueried = true;
      _notify();
      return;
    }

    _sub = _iap.purchaseStream.listen(
      _onPurchaseUpdate,
      onDone: () => _sub?.cancel(),
      onError: (e) {
        lastError = e.toString();
        purchasePending = false;
        _notify();
      },
    );

    await _queryProducts();
  }

  Future<void> _queryProducts() async {
    try {
      final response = await _iap.queryProductDetails(BillingIds.productIds);
      if (response.error == null && response.productDetails.isNotEmpty) {
        premiumProduct = response.productDetails.firstWhere(
          (p) => p.id == BillingIds.premiumLifetime,
          orElse: () => response.productDetails.first,
        );
      } else if (response.notFoundIDs.isNotEmpty) {
        // Play Console'da ürün henüz tanımlanmamış/yayınlanmamış olabilir.
        lastError = 'product_not_found';
      }
    } catch (e) {
      lastError = e.toString();
    }
    storeQueried = true;
    _notify();
  }

  /// Ürün mağazadan henüz okunamadıysa tekrar dener.
  Future<void> ensureProductLoaded() async {
    if (premiumProduct == null && available) {
      await _queryProducts();
    }
  }

  Future<void> buyPremium() async {
    if (!available) {
      lastError = 'store_unavailable';
      _notify();
      return;
    }
    await ensureProductLoaded();
    final product = premiumProduct;
    if (product == null) {
      lastError = 'product_not_found';
      _notify();
      return;
    }
    purchasePending = true;
    lastError = null;
    _notify();
    final param = PurchaseParam(productDetails: product);
    try {
      // Kalıcı (bir kere satın alınan, tüketilmeyen) premium özellik.
      await _iap.buyNonConsumable(purchaseParam: param);
    } catch (e) {
      purchasePending = false;
      lastError = e.toString();
      _notify();
    }
  }

  /// Kullanıcı cihaz/hesap değiştirdiğinde ya da uygulamayı yeniden
  /// yüklediğinde daha önce satın aldığı premium'u geri yükler.
  /// Hem Play Store hem App Store politikaları restore akışı ister.
  Future<void> restorePurchases() async {
    if (!available) return;
    lastError = null;
    try {
      await _iap.restorePurchases();
    } catch (e) {
      lastError = e.toString();
      _notify();
    }
  }

  void _onPurchaseUpdate(List<PurchaseDetails> purchases) async {
    for (final purchase in purchases) {
      switch (purchase.status) {
        case PurchaseStatus.pending:
          purchasePending = true;
          break;
        case PurchaseStatus.error:
          purchasePending = false;
          lastError = purchase.error?.message ?? 'purchase_error';
          break;
        case PurchaseStatus.canceled:
          purchasePending = false;
          break;
        case PurchaseStatus.purchased:
        case PurchaseStatus.restored:
          purchasePending = false;
          if (purchase.productID == BillingIds.premiumLifetime) {
            // NOT: Üretimde burada, sunucu tarafında Play Developer API
            // (purchases.products.get) ile satın almanın gerçekten geçerli
            // ve daha önce iptal/iade edilmemiş olduğunu doğrulamanız
            // önerilir. Yalnızca istemci tarafı doğrulama, sahte/oynanmış
            // satın alma bildirimlerine karşı yeterli koruma sağlamaz.
            _onPremiumUnlocked?.call();
          }
          break;
      }
      if (purchase.pendingCompletePurchase) {
        await _iap.completePurchase(purchase);
      }
    }
    _notify();
  }

  void dispose() {
    _sub?.cancel();
  }
}

// ══════════════════════════════════════════════════════════════════
//  ADMOB REKLAM ALT YAPISI
//  Tüm reklam birimi kimlikleri tek bir yerden yönetilir. Premium
//  kullanıcılar için tüm reklamlar (AdManager.instance.isPremium=true
//  olduğunda) otomatik olarak devre dışı kalır.
// ══════════════════════════════════════════════════════════════════
class AdIds {
  AdIds._();
  static const String banner = 'ca-app-pub-6551908952762916/2065982369';
  static const String interstitial = 'ca-app-pub-6551908952762916/9670808516';
  static const String native = 'ca-app-pub-6551908952762916/4364842648';
  static const String rewarded = 'ca-app-pub-6551908952762916/8774860946';
}

class AdManager {
  AdManager._();
  static final AdManager instance = AdManager._();

  /// MainShell içinde AppState değiştikçe güncellenir. true olduğunda
  /// hiçbir reklam yüklenmez / gösterilmez.
  bool isPremium = false;

  InterstitialAd? _interstitialAd;
  bool _interstitialLoading = false;

  RewardedAd? _rewardedAd;
  bool _rewardedLoading = false;

  int _actionCount = 0;
  static const int _interstitialFrequency = 2; // her 2 eylemde bir göster

  void setPremium(bool value) {
    if (isPremium == value) return;
    isPremium = value;
    if (isPremium) {
      _interstitialAd?.dispose();
      _interstitialAd = null;
      _rewardedAd?.dispose();
      _rewardedAd = null;
    }
  }

  // ──────────────── GEÇİŞ (INTERSTITIAL) REKLAMI ────────────────
  void preloadInterstitial() {
    if (isPremium) return;
    if (_interstitialAd != null || _interstitialLoading) return;
    _interstitialLoading = true;
    try {
      InterstitialAd.load(
        adUnitId: AdIds.interstitial,
        request: const AdRequest(),
        adLoadCallback: InterstitialAdLoadCallback(
          onAdLoaded: (ad) {
            _interstitialAd = ad;
            _interstitialLoading = false;
          },
          onAdFailedToLoad: (error) {
            _interstitialLoading = false;
            _interstitialAd = null;
          },
        ),
      );
    } catch (_) {
      // Reklam SDK'sı bir sebeple yüklenemezse uygulama çökmesin.
      _interstitialLoading = false;
      _interstitialAd = null;
    }
  }

  /// Sıklık kontrolüyle (varsayılan: her 2 eylemde bir) geçiş reklamı
  /// göstermeyi dener. Reklam hazır değilse veya kullanıcı Premium ise
  /// doğrudan [onDone] çağrılır; akış asla bloklanmaz.
  void maybeShowInterstitial({required bool isPremiumUser, VoidCallback? onDone}) {
    setPremium(isPremiumUser);
    if (isPremiumUser) {
      onDone?.call();
      return;
    }
    _actionCount++;
    if (_actionCount % _interstitialFrequency != 0 || _interstitialAd == null) {
      preloadInterstitial();
      onDone?.call();
      return;
    }
    final ad = _interstitialAd!;
    _interstitialAd = null;
    try {
      ad.fullScreenContentCallback = FullScreenContentCallback(
        onAdDismissedFullScreenContent: (a) {
          a.dispose();
          preloadInterstitial();
          onDone?.call();
        },
        onAdFailedToShowFullScreenContent: (a, err) {
          a.dispose();
          preloadInterstitial();
          onDone?.call();
        },
      );
      ad.show();
    } catch (_) {
      // Gösterim sırasında bir hata olursa akışı bozmadan devam et.
      preloadInterstitial();
      onDone?.call();
    }
  }

  // ──────────────── ÖDÜLLÜ (REWARDED) REKLAM ────────────────
  void preloadRewarded() {
    if (isPremium) return;
    if (_rewardedAd != null || _rewardedLoading) return;
    _rewardedLoading = true;
    try {
      RewardedAd.load(
        adUnitId: AdIds.rewarded,
        request: const AdRequest(),
        rewardedAdLoadCallback: RewardedAdLoadCallback(
          onAdLoaded: (ad) {
            _rewardedAd = ad;
            _rewardedLoading = false;
          },
          onAdFailedToLoad: (error) {
            _rewardedLoading = false;
            _rewardedAd = null;
          },
        ),
      );
    } catch (_) {
      _rewardedLoading = false;
      _rewardedAd = null;
    }
  }

  bool get isRewardedReady => _rewardedAd != null;

  void showRewarded({
    required void Function(int amount) onReward,
    required VoidCallback onUnavailable,
  }) {
    final ad = _rewardedAd;
    if (isPremium || ad == null) {
      preloadRewarded();
      onUnavailable();
      return;
    }
    _rewardedAd = null;
    try {
      ad.fullScreenContentCallback = FullScreenContentCallback(
        onAdDismissedFullScreenContent: (a) {
          a.dispose();
          preloadRewarded();
        },
        onAdFailedToShowFullScreenContent: (a, err) {
          a.dispose();
          preloadRewarded();
          onUnavailable();
        },
      );
      ad.show(
        onUserEarnedReward: (ad, reward) {
          onReward(reward.amount.toInt());
        },
      );
    } catch (_) {
      preloadRewarded();
      onUnavailable();
    }
  }
}

