class SignQuizScreen extends StatefulWidget {
  final String category;
  final int questionCount;
  const SignQuizScreen({super.key, required this.category, this.questionCount = 12});
  @override
  State<SignQuizScreen> createState() => _SignQuizScreenState();
}

class _SignQuizScreenState extends State<SignQuizScreen> {
  late final List<TrafficSign> _pool;
  late final List<_SignQuestion> _questions;
  int _index = 0;
  int? _selected;
  bool _answered = false;
  int _correct = 0;

  @override
  void initState() {
    super.initState();
    _pool = TrafficSignBank.forCategory(widget.category);
    _questions = _buildQuestions();
  }

  List<_SignQuestion> _buildQuestions() {
    final rnd = Random();
    final shuffledPool = List<TrafficSign>.from(_pool)..shuffle(rnd);
    final count = min(widget.questionCount, shuffledPool.length);
    final chosen = shuffledPool.sublist(0, count);
    return chosen.map((sign) {
      final distractors = List<TrafficSign>.from(_pool)
        ..remove(sign)
        ..shuffle(rnd);
      final wrongOptions = distractors.take(3).map((s) => s.name).toList();
      final options = [sign.name, ...wrongOptions]..shuffle(rnd);
      // az levha varsa 2-3 seçenekle devam edilebilir
      return _SignQuestion(sign: sign, options: options, correctText: sign.name);
    }).toList();
  }

  void _select(int i) {
    if (_answered) return;
    HapticFeedback.selectionClick();
    setState(() {
      _selected = i;
      _answered = true;
      if (_questions[_index].options[i] == _questions[_index].correctText) {
        _correct++;
        SignProgressStore.setKnown(_questions[_index].sign.id, true);
      } else {
        SignProgressStore.setKnown(_questions[_index].sign.id, false);
      }
    });
  }

  void _next() {
    if (_index >= _questions.length - 1) {
      Navigator.of(context).pushReplacement(MaterialPageRoute(
        builder: (_) => _SignQuizResultScreen(
          correct: _correct, total: _questions.length, category: widget.category,
        ),
      ));
      return;
    }
    setState(() {
      _index++;
      _selected = null;
      _answered = false;
    });
  }

  @override
  Widget build(BuildContext context) {
    final isDark = Theme.of(context).brightness == Brightness.dark;

    if (_questions.isEmpty) {
      return Scaffold(
        backgroundColor: isDark ? kSurfaceDark : const Color(0xFFF4F5F8),
        appBar: AppBar(
          title: const Text('Mini Test'),
          backgroundColor: Theme.of(context).appBarTheme.backgroundColor,
          foregroundColor: Theme.of(context).colorScheme.onSurface,
        ),
        body: Center(child: Text('Bu kategoride yeterli levha yok.', style: ts(size: 13, color: isDark ? Colors.white54 : Colors.black45))),
      );
    }

    final q = _questions[_index];
    return Scaffold(
      backgroundColor: isDark ? kSurfaceDark : const Color(0xFFF4F5F8),
      appBar: AppBar(
        title: Text('${kSignCategoryTitles[widget.category]} · Mini Test', style: ts(size: 14.5, w: FontWeight.w700, color: Theme.of(context).colorScheme.onSurface)),
        backgroundColor: Theme.of(context).appBarTheme.backgroundColor,
        foregroundColor: Theme.of(context).colorScheme.onSurface,
        elevation: 0,
      ),
      body: Column(children: [
        LinearProgressIndicator(
          value: (_index + 1) / _questions.length,
          minHeight: 4,
          backgroundColor: isDark ? kCardElevatedDark : const Color(0xFFE8EAED),
          valueColor: const AlwaysStoppedAnimation<Color>(kPrimary),
        ),
        Expanded(
          child: ListView(
            padding: const EdgeInsets.all(18),
            children: [
              Text('${_index + 1} / ${_questions.length}', style: ts(size: 12, color: isDark ? Colors.white54 : Colors.black45)),
              const SizedBox(height: 12),
              Center(
                child: Container(
                  width: 170,
                  height: 170,
                  padding: const EdgeInsets.all(14),
                  decoration: BoxDecoration(
                    color: isDark ? Colors.white.withOpacity(0.07) : const Color(0xFFF3F5F9),
                    borderRadius: BorderRadius.circular(20),
                    border: Border.all(color: isDark ? Colors.white12 : const Color(0xFFE2E6EE)),
                  ),
                  child: Center(child: TrafficSignBadge(sign: q.sign, size: 130)),
                ),
              ),
              const SizedBox(height: 12),
              Center(
                child: Text('Bu levhanın anlamı nedir?',
                    style: ts(size: 14, w: FontWeight.w700, color: isDark ? Colors.white : Colors.black87)),
              ),
              const SizedBox(height: 18),
              ...List.generate(q.options.length, (i) {
                OptionState state = OptionState.idle;
                if (_answered) {
                  if (q.options[i] == q.correctText) {
                    state = OptionState.correct;
                  } else if (i == _selected) {
                    state = OptionState.wrong;
                  }
                } else if (_selected == i) {
                  state = OptionState.selected;
                }
                return OptionTile(
                  label: String.fromCharCode(65 + i),
                  text: q.options[i],
                  state: state,
                  isDark: isDark,
                  onTap: () => _select(i),
                );
              }),
            ],
          ),
        ),
        Padding(
          padding: const EdgeInsets.fromLTRB(18, 4, 18, 18),
          child: SizedBox(
            width: double.infinity,
            child: ElevatedButton(
              onPressed: _answered ? _next : null,
              child: Text(_index >= _questions.length - 1 ? 'BİTİR' : 'SONRAKİ',
                  style: ts(size: 14.5, w: FontWeight.w800, color: kSurface)),
            ),
          ),
        ),
      ]),
    );
  }
}

