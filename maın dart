// ------------------------------------------------------------
//  SECTION: services/remote_question_service.dart
// ------------------------------------------------------------
// ============================================================
//  REMOTE QUESTION SERVICE  —  isteğe bağlı soru bankası API'si
//  ------------------------------------------------------------
//  Uygulama içinde hazır/çalışan bir "soru API'si" yoktur; böyle bir
//  API'yi güvenli biçimde bağlamanın tek yolu KENDİ sunucunuzda bir
//  uç nokta (endpoint) barındırmaktır. İstemci (mobil uygulama)
//  içine üçüncü taraf bir yapay zekâ servisinin gizli API anahtarını
//  gömmek GÜVENLİ DEĞİLDİR (herkes uygulamayı tersine mühendislikle
//  açıp anahtarınızı çalabilir). Bu yüzden burada, sizin kendi
//  sunucunuzdan (Firebase Hosting, basit bir Cloud Function, kendi
//  backend'iniz vb.) Question.toJson() formatında bir JSON listesi
//  servis eden GERÇEK ÇALIŞAN bir istemci bırakıyoruz.
//
//  Kullanmak için:
//   1) _endpoint sabitini kendi sunucu adresinizle değiştirin.
//   2) Sunucu, [ {"id":"x_001","category":"trafik", ...}, ... ]
//      formatında bir JSON dizisi döndürmelidir (bkz. Question.toJson).
//   3) Ayarlar > "Soru Bankasını Sunucudan Güncelle" ile senkronize
//      edilir; gelen sorular cihazda önbelleğe alınır ve mevcut soru
//      bankasına otomatik eklenir.
// ============================================================

class RemoteQuestionService {
  RemoteQuestionService._();

  static const String _endpoint = 'https://sizin-sunucunuz.com/api/questions.json';

  /// Sunucudan ek soru listesini çeker. Herhangi bir hata durumunda
  /// (endpoint tanımlı değil, ağ hatası, geçersiz JSON) boş liste
  /// döner — uygulama asla bu yüzden çökmez.
  static Future<List<Question>> fetchRemoteQuestions() async {
    final client = HttpClient();
    client.connectionTimeout = const Duration(seconds: 8);
    try {
      final req = await client.getUrl(Uri.parse(_endpoint));
      final res = await req.close();
      if (res.statusCode != 200) return [];
      final body = await res.transform(utf8.decoder).join();
      final decoded = jsonDecode(body);
      if (decoded is! List) return [];
      final out = <Question>[];
      for (final item in decoded) {
        try {
          out.add(Question.fromJson(item as Map<String, dynamic>));
        } catch (_) {
          // Bozuk tekil kayıt tüm senkronizasyonu bozmasın diye atlanır.
        }
      }
      return out;
    } catch (_) {
      return [];
    } finally {
      client.close();
    }
  }
}

// ------------------------------------------------------------
//  SECTION: data/question_bank.dart
// ------------------------------------------------------------
// ============================================================
//  QUESTION BANK PROVIDER — tüm kategorileri birleştirir,
//  pratik/deneme/gerçek sınav soru çekme mantığını sağlar.
// ============================================================

class QuestionBank {
  QuestionBank._();

  /// Sunucudan senkronize edilip cihaza önbelleğe alınmış ek sorular.
  /// AppState.bootstrap() sırasında SharedPreferences'tan yüklenir.
  static List<Question> customQuestions = [];

  static final Map<String, List<Question>> byCategory = {
    catTrafik: trafikCevreQuestions,
    catIlkYardim: ilkYardimQuestions,
    catMotor: motorAracQuestions,
    catAdab: trafikAdabQuestions,
  };

  static List<Question> get all => [
        ...trafikCevreQuestions,
        ...ilkYardimQuestions,
        ...motorAracQuestions,
        ...trafikAdabQuestions,
        ...customQuestions,
      ];

  static Question? byId(String id) {
    for (final q in all) {
      if (q.id == id) return q;
    }
    return null;
  }

  static List<Question> forCategory(String category) => [
        ...(byCategory[category] ?? const []),
        ...customQuestions.where((q) => q.category == category),
      ];

  /// Belirli bir kategoriden rastgele [count] adet soru döner.
  /// count, mevcut soru sayısından fazlaysa mevcut tüm sorular
  /// karıştırılıp döndürülür (tekrar kullanmadan).
  static List<Question> randomFrom(String category, int count, {int? seed}) {
    final pool = List<Question>.from(forCategory(category));
    pool.shuffle(Random(seed));
    if (count >= pool.length) return pool;
    return pool.sublist(0, count);
  }

  /// Gerçek sınav formatına uygun 50 soruluk deneme seti üretir:
  /// kExamDistribution içindeki kategori dağılımına göre soru çeker.
  static List<Question> buildExamSet({int? seed}) {
    final rnd = Random(seed);
    final result = <Question>[];
    kExamDistribution.forEach((cat, count) {
      result.addAll(randomFrom(cat, count, seed: rnd.nextInt(1 << 31)));
    });
    result.shuffle(rnd);
    return result;
  }

  /// Belirli bir konudan pratik seti üretir (varsayılan: tüm konu soruları).
  static List<Question> buildPracticeSet(String category, {int? limit, int? seed}) {
    final pool = List<Question>.from(forCategory(category));
    pool.shuffle(Random(seed));
    if (limit != null && limit < pool.length) return pool.sublist(0, limit);
    return pool;
  }
}

// ------------------------------------------------------------
//  SECTION: services/app_state.dart
// ------------------------------------------------------------
// ============================================================
//  APP STATE  —  SharedPreferences tabanlı kalıcı veri katmanı
//  Yanlış sorular, hesaplama/deneme geçmişi, kategori istatistikleri.
// ============================================================

class AppState {
  static SharedPreferences? _prefs;
  static bool _initDone = false;

  static Future<void> bootstrap() async {
    if (_initDone) return;
    _prefs = await SharedPreferences.getInstance();
    _initDone = true;
    _loadCachedRemoteQuestions();
  }

  static SharedPreferences get prefs {
    assert(_initDone, 'AppState.bootstrap() must be called first');
    return _prefs!;
  }

  // ─── Tema ───
  static bool get isDark => prefs.getBool('is_dark') ?? true;
  static Future<void> setDark(bool v) async => unawaited(prefs.setBool('is_dark', v));

  // ─── Uzaktan (sunucu) senkronize edilen ek sorular ───
  static void _loadCachedRemoteQuestions() {
    final raw = prefs.getStringList('remote_questions') ?? [];
    final out = <Question>[];
    for (final s in raw) {
      try {
        out.add(Question.fromJson(jsonDecode(s) as Map<String, dynamic>));
      } catch (_) {}
    }
    QuestionBank.customQuestions = out;
  }

  static Future<int> syncRemoteQuestions() async {
    final fetched = await RemoteQuestionService.fetchRemoteQuestions();
    if (fetched.isEmpty) return 0;
    QuestionBank.customQuestions = fetched;
    final encoded = fetched.map((q) => jsonEncode(q.toJson())).toList();
    unawaited(prefs.setStringList('remote_questions', encoded));
    return fetched.length;
  }

  // ─── Yanlış Sorular (soru id seti) ───
  static Set<String> loadWrongIds() => (prefs.getStringList('wrong_ids') ?? []).toSet();

  static Future<void> markWrong(String questionId) async {
    final s = loadWrongIds();
    s.add(questionId);
    unawaited(prefs.setStringList('wrong_ids', s.toList()));
  }

  static Future<void> markCorrectRemovesWrong(String questionId) async {
    final s = loadWrongIds();
    if (s.remove(questionId)) {
      unawaited(prefs.setStringList('wrong_ids', s.toList()));
    }
  }

  static Future<void> clearWrongIds() async => unawaited(prefs.setStringList('wrong_ids', []));

  static Future<void> removeWrongId(String questionId) async {
    final s = loadWrongIds();
    if (s.remove(questionId)) {
      unawaited(prefs.setStringList('wrong_ids', s.toList()));
    }
  }

  // ─── Deneme / Pratik Geçmişi ───
  static Future<void> saveAttempt(ExamAttempt attempt) async {
    final hist = List<String>.from(prefs.getStringList('attempt_history') ?? []);
    hist.insert(0, jsonEncode(attempt.toJson()));
    if (hist.length > 200) hist.removeLast();
    unawaited(prefs.setStringList('attempt_history', hist));
  }

  static List<ExamAttempt> loadAttempts() {
    final raw = prefs.getStringList('attempt_history') ?? [];
    final out = <ExamAttempt>[];
    for (final s in raw) {
      try {
        out.add(ExamAttempt.fromJson(jsonDecode(s) as Map<String, dynamic>));
      } catch (_) {}
    }
    return out;
  }

  static Future<void> clearAttempts() async => unawaited(prefs.setStringList('attempt_history', []));

  // ─── Kategori Bazlı Toplam Doğru/Yanlış (kalıcı analiz için) ───
  static Map<String, int> _loadIntMap(String key) {
    final raw = prefs.getString(key);
    if (raw == null) return {};
    try {
      final m = jsonDecode(raw) as Map<String, dynamic>;
      return m.map((k, v) => MapEntry(k, (v as num).toInt()));
    } catch (_) {
      return {};
    }
  }

  static Future<void> _saveIntMap(String key, Map<String, int> map) async =>
      unawaited(prefs.setString(key, jsonEncode(map)));

  static Map<String, int> loadCategoryCorrect() => _loadIntMap('cat_correct');
  static Map<String, int> loadCategoryTotal() => _loadIntMap('cat_total');

  static Future<void> addCategoryResult(String category, {required bool correct}) async {
    final totals = loadCategoryTotal();
    final corrects = loadCategoryCorrect();
    totals[category] = (totals[category] ?? 0) + 1;
    if (correct) corrects[category] = (corrects[category] ?? 0) + 1;
    await _saveIntMap('cat_total', totals);
    await _saveIntMap('cat_correct', corrects);
  }

  /// Kategori bazlı başarı yüzdesi (0-100). Hiç veri yoksa null döner.
  static Map<String, double?> categorySuccessRates() {
    final totals = loadCategoryTotal();
    final corrects = loadCategoryCorrect();
    final result = <String, double?>{};
    for (final cat in kCategoryTitles.keys) {
      final t = totals[cat] ?? 0;
      final c = corrects[cat] ?? 0;
      result[cat] = t == 0 ? null : (c / t) * 100.0;
    }
    return result;
  }

  static Future<void> resetAllProgress() async {
    await clearWrongIds();
    await clearAttempts();
    await _saveIntMap('cat_total', {});
    await _saveIntMap('cat_correct', {});
  }
}

