// ------------------------------------------------------------
//  SECTION: services/sign_progress_store.dart
//  "Öğrendim / Biliyorum" ilerlemesi bellek-içinde tutulur (uygulama
//  yeniden başlatıldığında sıfırlanır). Kalıcı hâle getirmek için
//  `shared_preferences` paketi eklenip burada dosyaya yazılabilir.
// ------------------------------------------------------------

class SignProgressStore {
  SignProgressStore._();

  static final Set<String> _known = <String>{};

  static Set<String> loadKnownIds() => Set<String>.from(_known);

  static Future<void> setKnown(String signId, bool known) async {
    if (known) {
      _known.add(signId);
    } else {
      _known.remove(signId);
    }
  }

  static bool isKnown(String signId) => _known.contains(signId);

  static double? categoryMasteryPercent(String category) {
    final signsInCat = TrafficSignBank.forCategory(category);
    if (signsInCat.isEmpty) return null;
    final count = signsInCat.where((s) => _known.contains(s.id)).length;
    return (count / signsInCat.length) * 100.0;
  }

  static Future<void> resetProgress() async => _known.clear();
}

