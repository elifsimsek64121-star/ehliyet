// ============================================================
//  MODEL — Question
// ============================================================
class Question {
  final String id;
  final String category; // catTrafik | catIlkYardim | catMotor | catAdab
  final String text;
  final List<String> options; // 4 seçenek (A-D)
  final int correctIndex;
  final String? explanation;

  const Question({
    required this.id,
    required this.category,
    required this.text,
    required this.options,
    required this.correctIndex,
    this.explanation,
  });

  Map<String, dynamic> toJson() => {
        'id': id,
        'category': category,
        'text': text,
        'options': options,
        'correctIndex': correctIndex,
        'explanation': explanation,
      };

  factory Question.fromJson(Map<String, dynamic> j) => Question(
        id: j['id'] as String,
        category: j['category'] as String,
        text: j['text'] as String,
        options: (j['options'] as List).map((e) => e.toString()).toList(),
        correctIndex: j['correctIndex'] as int,
        explanation: j['explanation'] as String?,
      );
}

// ------------------------------------------------------------
//  SECTION: data/models/exam_attempt.dart
// ------------------------------------------------------------
// ============================================================
//  MODEL — ExamAttempt (deneme / pratik sonucu geçmişi)
// ============================================================
class ExamAttempt {
  final String id;
  final DateTime date;
  final String mode; // 'practice' | 'deneme' | 'real'
  final String? category; // pratik modda tek kategori olabilir
  final int totalQuestions;
  final int correct;
  final int wrong;
  final int empty;
  final double scoreOn100;
  final bool passed;
  final Map<String, int> correctByCategory;
  final Map<String, int> totalByCategory;

  const ExamAttempt({
    required this.id,
    required this.date,
    required this.mode,
    this.category,
    required this.totalQuestions,
    required this.correct,
    required this.wrong,
    required this.empty,
    required this.scoreOn100,
    required this.passed,
    required this.correctByCategory,
    required this.totalByCategory,
  });

  Map<String, dynamic> toJson() => {
        'id': id,
        'date': date.toIso8601String(),
        'mode': mode,
        'category': category,
        'totalQuestions': totalQuestions,
        'correct': correct,
        'wrong': wrong,
        'empty': empty,
        'scoreOn100': scoreOn100,
        'passed': passed,
        'correctByCategory': correctByCategory,
        'totalByCategory': totalByCategory,
      };

  factory ExamAttempt.fromJson(Map<String, dynamic> j) => ExamAttempt(
        id: j['id'] as String,
        date: DateTime.tryParse(j['date']?.toString() ?? '') ?? DateTime.now(),
        mode: j['mode']?.toString() ?? 'practice',
        category: j['category'] as String?,
        totalQuestions: j['totalQuestions'] as int? ?? 0,
        correct: j['correct'] as int? ?? 0,
        wrong: j['wrong'] as int? ?? 0,
        empty: j['empty'] as int? ?? 0,
        scoreOn100: (j['scoreOn100'] as num?)?.toDouble() ?? 0,
        passed: j['passed'] as bool? ?? false,
        correctByCategory: (j['correctByCategory'] as Map?)
                ?.map((k, v) => MapEntry(k.toString(), (v as num).toInt())) ??
            {},
        totalByCategory: (j['totalByCategory'] as Map?)
                ?.map((k, v) => MapEntry(k.toString(), (v as num).toInt())) ??
            {},
      );
}

