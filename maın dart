// ============================================================
//  READINESS SCREEN  —  "Sınava Hazır mıyım?"
//  Konu bazlı başarı yüzdelerine göre kişiselleştirilmiş öneri.
// ============================================================

class ReadinessScreen extends StatelessWidget {
  const ReadinessScreen({super.key});

  String _emoji(double? pct) {
    if (pct == null) return '⚪';
    if (pct >= 80) return '🟢';
    if (pct >= 60) return '🟡';
    return '🔴';
  }

  @override
  Widget build(BuildContext context) {
    final isDark = Theme.of(context).brightness == Brightness.dark;
    final rates = AppState.categorySuccessRates();
    final hasAnyData = rates.values.any((v) => v != null);

    // Genel hazırlık skoru: veri olan kategorilerin ortalaması
    final known = rates.values.whereType<double>().toList();
    final overall = known.isEmpty ? null : known.reduce((a, b) => a + b) / known.length;

    // En zayıf konu (veri olanlar arasından)
    String? weakestCat;
    double weakestVal = 101;
    rates.forEach((cat, v) {
      if (v != null && v < weakestVal) {
        weakestVal = v;
        weakestCat = cat;
      }
    });

    final ready = overall != null && overall >= 80 && known.length == kCategoryTitles.length;

    return Scaffold(
      backgroundColor: isDark ? kSurface : const Color(0xFFF4F5F8),
      appBar: AppBar(
        title: Text('Sınava Hazır mıyım?', style: ts(size: 16, w: FontWeight.w700, color: Colors.white)),
        backgroundColor: kCardElevated,
        foregroundColor: Colors.white,
        elevation: 0,
      ),
      bottomNavigationBar: const BannerAdWidget(),
      body: ListView(
        padding: const EdgeInsets.all(16),
        children: [
          if (!hasAnyData)
            Container(
              padding: const EdgeInsets.all(24),
              decoration: BoxDecoration(
                color: isDark ? kCard : Colors.white,
                borderRadius: BorderRadius.circular(18),
                border: Border.all(color: isDark ? kBorder : const Color(0xFFE4E6EC)),
              ),
              child: Column(children: [
                Icon(Icons.query_stats_rounded, size: 46, color: isDark ? Colors.white24 : Colors.black26),
                const SizedBox(height: 12),
                Text('Henüz yeterli veri yok', style: ts(size: 15, w: FontWeight.w700, color: isDark ? Colors.white : Colors.black87)),
                const SizedBox(height: 6),
                Text('Hazırlık durumunu görebilmek için birkaç test çöz.',
                    textAlign: TextAlign.center, style: ts(size: 12.5, color: isDark ? Colors.white38 : Colors.black38)),
              ]),
            )
          else ...[
            Container(
              padding: const EdgeInsets.all(20),
              decoration: BoxDecoration(
                gradient: const LinearGradient(colors: [Color(0xFF16203A), Color(0xFF0F1526)], begin: Alignment.topLeft, end: Alignment.bottomRight),
                borderRadius: BorderRadius.circular(20),
                border: Border.all(color: const Color(0x33C9A24B)),
              ),
              child: Column(children: [
                Text('🎯 Sınava Hazırlık Durumun', style: ts(size: 13, w: FontWeight.w800, color: kPrimarySoft)),
                const SizedBox(height: 10),
                Text(overall == null ? '—' : '%${overall.toStringAsFixed(0)}', style: tsD(size: 48, w: FontWeight.w800, color: Colors.white)),
                const SizedBox(height: 6),
                Container(
                  padding: const EdgeInsets.symmetric(horizontal: 14, vertical: 6),
                  decoration: BoxDecoration(color: (ready ? kSuccess : kWarning).withAlpha(40), borderRadius: BorderRadius.circular(20)),
                  child: Text(ready ? 'SINAVA HAZIRSIN! 🎉' : 'HENÜZ HAZIR DEĞİLSİN', style: ts(size: 12.5, w: FontWeight.w800, color: ready ? kSuccess : kWarning)),
                ),
              ]),
            ),
            const SizedBox(height: 18),
            ...kCategoryTitles.entries.map((e) {
              final pct = rates[e.key];
              return Container(
                margin: const EdgeInsets.only(bottom: 8),
                padding: const EdgeInsets.symmetric(horizontal: 14, vertical: 12),
                decoration: BoxDecoration(
                  color: isDark ? kCard : Colors.white,
                  borderRadius: BorderRadius.circular(12),
                  border: Border.all(color: isDark ? kBorder : const Color(0xFFE4E6EC)),
                ),
                child: Row(children: [
                  Text(_emoji(pct), style: const TextStyle(fontSize: 18)),
                  const SizedBox(width: 10),
                  Expanded(child: Text(e.value, style: ts(size: 14, w: FontWeight.w700, color: isDark ? Colors.white : Colors.black87))),
                  Text(pct == null ? 'Veri yok' : '%${pct.toStringAsFixed(0)}', style: ts(size: 14, w: FontWeight.w800, color: isDark ? Colors.white70 : Colors.black54)),
                ]),
              );
            }),
            const SizedBox(height: 16),
            if (weakestCat != null) Container(
              padding: const EdgeInsets.all(16),
              decoration: BoxDecoration(color: const Color(0x22E0A62B), borderRadius: BorderRadius.circular(14), border: Border.all(color: const Color(0x44E0A62B))),
              child: Column(crossAxisAlignment: CrossAxisAlignment.start, children: [
                Row(children: [
                  const Icon(Icons.warning_amber_rounded, color: kWarning, size: 20),
                  const SizedBox(width: 8),
                  Expanded(child: Text('En zayıf konun: ${kCategoryTitles[weakestCat]}', style: ts(size: 13.5, w: FontWeight.w800, color: kWarning))),
                ]),
                const SizedBox(height: 8),
                Text('Bugünkü önerin: ${kCategoryTitles[weakestCat]} konusundan 20 soru çöz.',
                    style: ts(size: 13, color: isDark ? Colors.white70 : Colors.black87, height: 1.35)),
                const SizedBox(height: 12),
                SizedBox(
                  width: double.infinity,
                  child: ElevatedButton.icon(
                    onPressed: () {
                      final cat = weakestCat!;
                      AdManager.tryShowInterstitial(every: 4, onDone: () {
                        Navigator.of(context).push(MaterialPageRoute(
                          builder: (_) => QuizScreen(
                            questions: QuestionBank.randomFrom(cat, 20),
                            mode: QuizMode.practice,
                            title: kCategoryTitles[cat] ?? cat,
                            singleCategory: cat,
                          ),
                        ));
                      });
                    },
                    icon: const Icon(Icons.play_arrow_rounded),
                    label: Text('${kCategoryTitles[weakestCat]} PRATİĞİNE BAŞLA', style: ts(size: 13, w: FontWeight.w800, color: kSurface)),
                  ),
                ),
              ]),
            ),
          ],
        ],
      ),
    );
  }
}

