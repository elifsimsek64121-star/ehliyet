//  QUESTION BANK  (assets/data/questions.json dosyasından yüklenir)
// ══════════════════════════════════════════════════════════════════
class QB {
  /// Sorular artık kodun içine gömülü değil; uygulama açılışında
  /// assets/data/questions.json dosyasından okunuyor. Bu, kaynak
  /// dosyasını küçük tutar ve soruların kod değiştirmeden
  /// güncellenebilmesini sağlar.
  static List<Q> all = [];
  static bool loaded = false;
  static String? loadError;

  static Future<void> load() async {
    try {
      final raw = await rootBundle.loadString('assets/data/questions.json');
      final List<dynamic> data = json.decode(raw) as List<dynamic>;
      all = data
          .map((e) => Q.fromJson(e as Map<String, dynamic>))
          .toList(growable: false);
      loaded = true;
    } catch (e) {
      // Dosya bulunamazsa veya bozuksa uygulama en azından açılabilsin.
      all = [];
      loaded = true;
      loadError = e.toString();
    }
  }

  static List<Q> byCat(Cat c) => all.where((q) => q.cat == c).toList();
  static List<Q> random(int n) {
    final list = List<Q>.from(all)..shuffle(Random());
    return list.take(n.clamp(0, list.length)).toList();
  }

  static List<Q> exam() {
    // Resmi e-sınava yakın dağılım (~50 soru):
    // Trafik+Levha+Ceza+Çevre ≈ 23, İlk Yardım 12, Motor+Teknik 9, Adab 6
    final result = <Q>[];
    final targets = {
      Cat.trafik: 12,
      Cat.levhalar: 6,
      Cat.ceza: 3,
      Cat.cevresel: 2,
      Cat.ilkYardim: 12,
      Cat.motor: 6,
      Cat.aracTeknik: 3,
      Cat.trafikAdabi: 6,
    };
    for (final cat in Cat.values) {
      final qs = byCat(cat)..shuffle(Random());
      result.addAll(qs.take(targets[cat] ?? 0));
    }
    // Eksik kalırsa rastgele tamamla
    if (result.length < 50) {
      final used = result.map((q) => q.id).toSet();
      final rest = all.where((q) => !used.contains(q.id)).toList()..shuffle(Random());
      result.addAll(rest.take(50 - result.length));
    }
    result.shuffle(Random());
    return result.take(50).toList();
  }
}

/// Konu anlatımları assets/data/topics.json dosyasından yüklenir.
class TopicsBank {
  static List<TopicLesson> all = [];
  static bool loaded = false;

  static IconData _icon(String? name) {
    switch (name) {
      case 'favorite':
        return Icons.favorite_rounded;
      case 'pan_tool':
        return Icons.pan_tool_rounded;
      case 'settings':
        return Icons.settings_rounded;
      case 'people':
        return Icons.people_rounded;
      case 'emergency':
        return Icons.emergency_rounded;
      case 'alt_route':
        return Icons.alt_route_rounded;
      case 'bloodtype':
        return Icons.bloodtype_rounded;
      case 'speed':
        return Icons.speed_rounded;
      case 'eco':
        return Icons.eco_rounded;
      case 'social_distance':
        return Icons.social_distance_rounded;
      case 'traffic':
        return Icons.traffic_rounded;
      case 'local_parking':
        return Icons.local_parking_rounded;
      case 'gavel':
        return Icons.gavel_rounded;
      default:
        return Icons.menu_book_rounded;
    }
  }

  static Color _color(String? hex) {
    if (hex == null || hex.isEmpty) return C.primary;
    final h = hex.replaceAll('#', '');
    if (h.length == 6) {
      return Color(int.parse('FF$h', radix: 16));
    }
    return C.primary;
  }

  static Future<void> load() async {
    try {
      final raw = await rootBundle.loadString('assets/data/topics.json');
      final List<dynamic> data = json.decode(raw) as List<dynamic>;
      all = data.map((e) {
        final m = e as Map<String, dynamic>;
        return TopicLesson(
          title: m['title'] as String? ?? '',
          category: m['category'] as String? ?? '',
          icon: _icon(m['icon'] as String?),
          color: _color(m['color'] as String?),
          points: List<String>.from(m['points'] as List? ?? const []),
          tip: m['tip'] as String? ?? '',
        );
      }).toList(growable: false);
      loaded = true;
    } catch (_) {
      all = [];
      loaded = true;
    }
  }
}

// ══════════════════════════════════════════════════════════════════
//  STATE MANAGEMENT — SharedPreferences ile kalıcı
// ══════════════════════════════════════════════════════════════════
class AppState extends ChangeNotifier {
  int navIdx = 0;
  int totalSolved = 0;
  int totalCorrect = 0;
  int streak = 0;
  int xp = 0;
  int level = 1;
  bool isPremium = false;
  Set<String> favIds = {};
  Map<Cat, int> catScores = {};
  List<ExamResult> history = [];

  // ── Yanlış soru takibi ──────────────────────────────────────
  Set<String> wrongIds = {};

  // ── Günlük hedef takibi ─────────────────────────────────────
  int solvedToday = 0;
  DateTime? _lastSolveDay;

  // ── Ayarlar (Settings) ──────────────────────────────────────
  bool notificationsEnabled = true;
  bool darkMode = false; // Varsayılan açık tema
  String language = 'Türkçe';

  bool _loaded = false;
  bool get isLoaded => _loaded;

  double get rate => totalSolved == 0 ? 0 : totalCorrect / totalSolved;

  /// Uygulama açılışında kalıcı verileri yükler.
  Future<void> load() async {
    try {
      final p = await SharedPreferences.getInstance();
      isPremium = p.getBool('isPremium') ?? false;
      notificationsEnabled = p.getBool('notificationsEnabled') ?? true;
      darkMode = p.getBool('darkMode') ?? false;
      language = p.getString('language') ?? 'Türkçe';
      totalSolved = p.getInt('totalSolved') ?? 0;
      totalCorrect = p.getInt('totalCorrect') ?? 0;
      streak = p.getInt('streak') ?? 0;
      xp = p.getInt('xp') ?? 0;
      level = p.getInt('level') ?? ((xp / 500).floor() + 1);
      favIds = (p.getStringList('favIds') ?? const []).toSet();
      wrongIds = (p.getStringList('wrongIds') ?? const []).toSet();
      solvedToday = p.getInt('solvedToday') ?? 0;
      final lastDayMs = p.getInt('lastSolveDay');
      if (lastDayMs != null) {
        _lastSolveDay = DateTime.fromMillisecondsSinceEpoch(lastDayMs);
      }
      // Kategori skorları
      final catRaw = p.getString('catScores');
      if (catRaw != null && catRaw.isNotEmpty) {
        try {
          final map = jsonDecode(catRaw) as Map<String, dynamic>;
          catScores = {
            for (final e in map.entries)
              if (Cat.values.any((c) => c.name == e.key))
                Cat.values.firstWhere((c) => c.name == e.key): (e.value as num).toInt(),
          };
        } catch (_) {}
      }
      // Sınav geçmişi (son 20)
      final histRaw = p.getString('examHistory');
      if (histRaw != null && histRaw.isNotEmpty) {
        try {
          final list = jsonDecode(histRaw) as List<dynamic>;
          history = list
              .map((j) => ExamResult.fromJson(j as Map<String, dynamic>))
              .toList();
        } catch (_) {}
      }
      AdManager.instance.setPremium(isPremium);
    } catch (_) {
      // Prefs okunamazsa varsayılanlarla devam
    }
    _loaded = true;
    notifyListeners();
  }

  Future<void> _persist() async {
    try {
      final p = await SharedPreferences.getInstance();
      await p.setBool('isPremium', isPremium);
      await p.setBool('notificationsEnabled', notificationsEnabled);
      await p.setBool('darkMode', darkMode);
      await p.setString('language', language);
      await p.setInt('totalSolved', totalSolved);
      await p.setInt('totalCorrect', totalCorrect);
      await p.setInt('streak', streak);
      await p.setInt('xp', xp);
      await p.setInt('level', level);
      await p.setStringList('favIds', favIds.toList());
      await p.setStringList('wrongIds', wrongIds.toList());
      await p.setInt('solvedToday', solvedToday);
      if (_lastSolveDay != null) {
        await p.setInt('lastSolveDay', _lastSolveDay!.millisecondsSinceEpoch);
      }
      await p.setString(
        'catScores',
        jsonEncode({for (final e in catScores.entries) e.key.name: e.value}),
      );
      await p.setString(
        'examHistory',
        jsonEncode(history.take(20).map((r) => r.toJson()).toList()),
      );
    } catch (_) {}
  }

  void setNav(int i) {
    navIdx = i;
    notifyListeners();
  }

  /// [qid] verilirse yanlış cevaplanan sorular otomatik olarak
  /// wrongIds listesine eklenir / doğru cevaplanınca çıkarılır.
  void answer(bool ok, Cat cat, [String? qid]) {
    _bumpDailyCounter();

    totalSolved++;
    if (ok) {
      totalCorrect++;
      xp += 10;
      catScores[cat] = (catScores[cat] ?? 0) + 1;
      if (qid != null) wrongIds.remove(qid);
    } else {
      if (qid != null) wrongIds.add(qid);
    }
    level = (xp / 500).floor() + 1;
    notifyListeners();
    _persist();
  }

  void _bumpDailyCounter() {
    final today = DateTime.now();
    final isSameDay = _lastSolveDay != null &&
        _lastSolveDay!.year == today.year &&
        _lastSolveDay!.month == today.month &&
        _lastSolveDay!.day == today.day;
    if (!isSameDay) {
      solvedToday = 0;
      _lastSolveDay = today;
    }
    solvedToday++;
  }

  void markCorrectedOut(String id) {
    wrongIds.remove(id);
    notifyListeners();
    _persist();
  }

  void clearWrongs() {
    wrongIds.clear();
    notifyListeners();
    _persist();
  }

  void toggleFav(String id) {
    favIds.contains(id) ? favIds.remove(id) : favIds.add(id);
    notifyListeners();
    _persist();
  }

  void addResult(ExamResult r) {
    history.insert(0, r);
    if (history.length > 20) history = history.take(20).toList();
    notifyListeners();
    _persist();
  }

  void unlockPremium() {
    isPremium = true;
    AdManager.instance.setPremium(true);
    notifyListeners();
    _persist();
  }

  void setNotifications(bool v) {
    notificationsEnabled = v;
    notifyListeners();
    _persist();
  }

  void setDarkMode(bool v) {
    darkMode = v;
    notifyListeners();
    _persist();
  }

  void setLanguage(String v) {
    language = v;
    notifyListeners();
    _persist();
  }

  /// Ödüllü reklam izlendiğinde bonus XP eklemek için kullanılır.
  void addXp(int amount) {
    xp += amount;
    level = (xp / 500).floor() + 1;
    notifyListeners();
    _persist();
  }
}

class ExamResult {
  final int correct, wrong, empty, total;
  final double score;
  final bool passed;
  final DateTime date;
  final Duration dur;
  ExamResult({
    required this.correct,
    required this.wrong,
    required this.empty,
    required this.total,
    required this.score,
    required this.passed,
    required this.dur,
    DateTime? date,
  }) : date = date ?? DateTime.now();

  Map<String, dynamic> toJson() => {
        'correct': correct,
        'wrong': wrong,
        'empty': empty,
        'total': total,
        'score': score,
        'passed': passed,
        'date': date.millisecondsSinceEpoch,
        'durMs': dur.inMilliseconds,
      };

  factory ExamResult.fromJson(Map<String, dynamic> j) => ExamResult(
        correct: (j['correct'] as num?)?.toInt() ?? 0,
        wrong: (j['wrong'] as num?)?.toInt() ?? 0,
        empty: (j['empty'] as num?)?.toInt() ?? 0,
        total: (j['total'] as num?)?.toInt() ?? 0,
        score: (j['score'] as num?)?.toDouble() ?? 0,
        passed: j['passed'] as bool? ?? false,
        dur: Duration(milliseconds: (j['durMs'] as num?)?.toInt() ?? 0),
        date: j['date'] != null
            ? DateTime.fromMillisecondsSinceEpoch((j['date'] as num).toInt())
            : DateTime.now(),
      );
}

