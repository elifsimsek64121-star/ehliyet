class _TriangleClipper extends CustomClipper<Path> {
  const _TriangleClipper();
  @override
  Path getClip(Size size) => Path()
    ..moveTo(size.width / 2, 0)
    ..lineTo(size.width, size.height)
    ..lineTo(0, size.height)
    ..close();
  @override
  bool shouldReclip(CustomClipper<Path> oldClipper) => false;
}

class _InvertedTriangleClipper extends CustomClipper<Path> {
  const _InvertedTriangleClipper();
  @override
  Path getClip(Size size) => Path()
    ..moveTo(0, 0)
    ..lineTo(size.width, 0)
    ..lineTo(size.width / 2, size.height)
    ..close();
  @override
  bool shouldReclip(CustomClipper<Path> oldClipper) => false;
}

class _DiamondClipper extends CustomClipper<Path> {
  const _DiamondClipper();
  @override
  Path getClip(Size size) => Path()
    ..moveTo(size.width / 2, 0)
    ..lineTo(size.width, size.height / 2)
    ..lineTo(size.width / 2, size.height)
    ..lineTo(0, size.height / 2)
    ..close();
  @override
  bool shouldReclip(CustomClipper<Path> oldClipper) => false;
}

class _OctagonClipper extends CustomClipper<Path> {
  const _OctagonClipper();
  @override
  Path getClip(Size size) {
    final w = size.width, h = size.height;
    final cut = w * 0.29;
    return Path()
      ..moveTo(cut, 0)
      ..lineTo(w - cut, 0)
      ..lineTo(w, cut)
      ..lineTo(w, h - cut)
      ..lineTo(w - cut, h)
      ..lineTo(cut, h)
      ..lineTo(0, h - cut)
      ..lineTo(0, cut)
      ..close();
  }
  @override
  bool shouldReclip(CustomClipper<Path> oldClipper) => false;
}

// ------------------------------------------------------------
//  SECTION: widgets/sign_badge.dart
//  Levhayı gerçek görsel dosyası kullanmadan şekil + renk + ikon
//  ile çizen widget.
//
//  DÜZELTME: Önceki sürümde iç şekil sadece üstten "padding" ile
//  küçültülüyordu; bu da üçgen/eşkenar dörtgen gibi şekillerde
//  çerçevenin eşit kalınlıkta olmamasına (şeklin bozuk görünmesine)
//  yol açıyordu. Artık iç şekil Transform.scale ile TAM ORTADAN
//  küçültülüyor, böylece kenarlıklar her yönde eşit kalınlıkta
//  çiziliyor ve levhalar gerçek trafik levhalarıyla birebir aynı
//  görünüyor.
// ------------------------------------------------------------

class TrafficSignBadge extends StatelessWidget {
  final TrafficSign sign;
  final double size;
  const TrafficSignBadge({super.key, required this.sign, this.size = 84});

  @override
  Widget build(BuildContext context) {
    switch (sign.shape) {
      case SignShape.triangle:
        return _shaped(
          clipper: const _TriangleClipper(),
          fill: Colors.white,
          border: kDanger,
          iconColor: const Color(0xFF1A1A1A),
          innerScale: 0.82,
          contentShift: size * 0.06, // üçgende görsel ağırlık merkezini aşağı kaydır
        );
      case SignShape.invertedTriangle:
        return _shaped(
          clipper: const _InvertedTriangleClipper(),
          fill: Colors.white,
          border: kDanger,
          iconColor: const Color(0xFF1A1A1A),
          innerScale: 0.82,
          contentShift: -size * 0.06,
        );
      case SignShape.diamondYellow:
        return _shaped(
          clipper: const _DiamondClipper(),
          fill: const Color(0xFFF5B942),
          border: const Color(0xFF1A1A1A),
          iconColor: const Color(0xFF1A1A1A),
          innerScale: 0.86,
        );
      case SignShape.octagon:
        return _shaped(
          clipper: const _OctagonClipper(),
          fill: kDanger,
          border: Colors.white,
          iconColor: Colors.white,
          innerScale: 0.90,
        );
      case SignShape.circleRed:
        return _circleOrSquare(
          isCircle: true,
          fill: Colors.white,
          border: kDanger,
          iconColor: const Color(0xFF1A1A1A),
          borderWidth: size * 0.10,
        );
      case SignShape.circleBlue:
        return _circleOrSquare(
          isCircle: true,
          fill: kNavyAccent,
          border: Colors.white,
          iconColor: Colors.white,
          borderWidth: size * 0.03,
        );
      case SignShape.squareBlue:
        return _circleOrSquare(
          isCircle: false,
          fill: kNavyAccent,
          border: Colors.white,
          iconColor: Colors.white,
          borderWidth: size * 0.03,
        );
    }
  }

  /// Üçgen / ters üçgen / eşkenar dörtgen / sekizgen gibi özel şekiller
  /// için: dış şekil kenarlık rengiyle, iç şekil ise TAM ORTADAN
  /// (Transform.scale ile) küçültülerek dolgu rengiyle çizilir. Böylece
  /// çerçeve kalınlığı her kenarda eşittir ve şekil bozulmaz.
  Widget _shaped({
    required CustomClipper<Path> clipper,
    required Color fill,
    required Color border,
    required Color iconColor,
    required double innerScale,
    double contentShift = 0,
  }) {
    return SizedBox(
      width: size,
      height: size,
      child: Stack(
        alignment: Alignment.center,
        children: [
          // Dış şekil = kenarlık rengi (tüm alanı kaplar)
          ClipPath(
            clipper: clipper,
            child: Container(color: border),
          ),
          // İç şekil = merkezden ölçeklenmiş dolgu rengi -> eşit çerçeve
          Transform.scale(
            scale: innerScale,
            child: ClipPath(
              clipper: clipper,
              child: Container(
                width: size,
                height: size,
                color: fill,
              ),
            ),
          ),
          // İkon / metin, şeklin görsel ağırlık merkezine göre hafifçe kaydırılır
          Transform.translate(
            offset: Offset(0, contentShift),
            child: _content(iconColor),
          ),
        ],
      ),
    );
  }

  Widget _circleOrSquare({
    required bool isCircle,
    required Color fill,
    required Color border,
    required Color iconColor,
    required double borderWidth,
  }) {
    return Container(
      width: size,
      height: size,
      decoration: BoxDecoration(
        color: fill,
        shape: isCircle ? BoxShape.circle : BoxShape.rectangle,
        borderRadius: isCircle ? null : BorderRadius.circular(size * 0.14),
        border: Border.all(color: border, width: borderWidth),
      ),
      alignment: Alignment.center,
      child: _content(iconColor),
    );
  }

  Widget _content(Color iconColor) {
    if (sign.overlayText != null) {
      return Text(sign.overlayText!,
          style: tsD(size: size * 0.30, w: FontWeight.w800, color: iconColor));
    }
    return Icon(sign.icon, size: size * 0.42, color: iconColor);
  }
}

