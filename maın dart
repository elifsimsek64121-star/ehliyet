  final String category;   // kSignCategory* sabitlerinden biri
  final String name;       // levhanın adı, örn. 'DUR'
  final String meaning;     // kısa anlamı
  final String whereUsed;  // nerede kullanılır
  final SignShape shape;
  final IconData icon;
  final String? overlayText; // örn. DUR levhası için 'DUR', hız levhası için '50'

  const TrafficSign({
    required this.id,
    required this.code,
    required this.category,
    required this.name,
    required this.meaning,
    required this.whereUsed,
    required this.shape,
    required this.icon,
    this.overlayText,
  });
}

