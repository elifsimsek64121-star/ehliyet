class AnalysisScreen extends StatefulWidget {
  const AnalysisScreen({super.key});
  @override
  State<AnalysisScreen> createState() => _AnalysisScreenState();
}

class _AnalysisScreenState extends State<AnalysisScreen> with AutomaticKeepAliveClientMixin {
  @override
  bool get wantKeepAlive => true;

  static const _icons = {
    catTrafik: Icons.traffic_rounded,
    catIlkYardim: Icons.medical_services_rounded,
    catMotor: Icons.settings_rounded,
    catAdab: Icons.handshake_rounded,
