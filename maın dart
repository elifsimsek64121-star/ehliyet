class RealExamScreen extends StatefulWidget {
  final AppState s;
  const RealExamScreen({super.key, required this.s});
  @override
  State<RealExamScreen> createState() => _RealExamState();
}

class _RealExamState extends State<RealExamScreen> {
  late List<Q> _qs;
  int _idx = 0;
  final Map<int, int> _ans = {};
  int _remaining = 45 * 60;
  Timer? _t;

  @override
  void initState() {
    super.initState();
    _qs = QB.exam();
    // Soru bankası boşsa (ör. questions.json henüz yüklenmediyse) zamanlayıcı
    // başlatılmaz; build() içinde kullanıcıya bilgi ekranı gösterilir.
    if (_qs.isNotEmpty) {
      _t = Timer.periodic(const Duration(seconds: 1), (t) {
        if (_remaining <= 0) {
          t.cancel();
          _finish();
        } else {
          setState(() => _remaining--);
        }
      });
    }
  }

  @override
  void dispose() {
    _t?.cancel();
    super.dispose();
  }

  String get _time {
    final m = _remaining ~/ 60, s = _remaining % 60;
    return '${m.toString().padLeft(2, '0')}:${s.toString().padLeft(2, '0')}';
  }

  bool get _urgent => _remaining < 300;

  void _finish() {
    _t?.cancel();
    if (_qs.isEmpty) return;
    int ok = 0, wr = 0;
    for (var i = 0; i < _qs.length; i++) {
      final a = _ans[i];
      if (a == null) continue;
      a == _qs[i].correct ? ok++ : wr++;
    }
    final em = _qs.length - _ans.length;
    final sc = (ok / _qs.length * 100).clamp(0.0, 100.0);
    final res = ExamResult(
      correct: ok,
      wrong: wr,
      empty: em,
      total: _qs.length,
      score: sc,
      passed: sc >= 70,
      dur: Duration(seconds: 45 * 60 - _remaining),
    );
    widget.s.addResult(res);
    // Sınav sonucuna geçmeden önce (sıklık kontrollü) geçiş reklamı denenir.
    AdManager.instance.maybeShowInterstitial(
      isPremiumUser: widget.s.isPremium,
      onDone: () {
        if (!mounted) return;
        Navigator.pushReplacement(
          context,
          _slideRoute(ExamResultScreen(res: res, s: widget.s)),
        );
      },
    );
  }

  @override
  Widget build(BuildContext context) {
    if (_qs.isEmpty) {
      // Soru bankası yüklenemediyse çökmek yerine bilgi ekranı göster.
      return Scaffold(
        appBar: AppBar(title: const Text('Deneme Sınavı')),
        body: const _EmptyState(
          icon: Icons.inbox_rounded,
          title: 'Sınav soruları yüklenemedi',
          subtitle: 'Soru bankası şu an kullanılamıyor.\nLütfen daha sonra tekrar deneyin.',
        ),
      );
    }
    final q = _qs[_idx];
    return Scaffold(
      appBar: AppBar(
        title: const Text('Deneme Sınavı'),
        actions: [
          Padding(
            padding: const EdgeInsets.only(right: 14),
            child: Center(
              child: AnimatedContainer(
                duration: const Duration(milliseconds: 300),
                padding: const EdgeInsets.symmetric(
                  horizontal: 14,
                  vertical: 7,
                ),
                decoration: BoxDecoration(
                  color: _urgent
                      ? C.err.withOpacity(.2)
                      : C.primary.withOpacity(.3),
                  borderRadius: BorderRadius.circular(14),
                  border: Border.all(color: _urgent ? C.errLight : C.pLight),
                ),
                child: Row(
                  children: [
                    Icon(
                      Icons.timer_rounded,
                      size: 16,
                      color: _urgent ? C.errLight : C.pLight,
                    ),
                    const SizedBox(width: 5),
                    Text(
                      _time,
                      style: TextStyle(
                        fontWeight: FontWeight.w900,
                        color: _urgent ? C.errLight : C.pLight,
                      ),
                    ),
                  ],
                ),
              ),
            ),
          ),
        ],
      ),
      body: Column(
        children: [
          Padding(
            padding: const EdgeInsets.symmetric(horizontal: 16),
            child: Column(
              children: [
                Row(
                  mainAxisAlignment: MainAxisAlignment.spaceBetween,
                  children: [
                    Text(
                      '${_idx + 1}/${_qs.length}',
                      style: const TextStyle(color: C.txt2),
                    ),
                    Text(
                      '${_ans.length} cevaplandı',
                      style: const TextStyle(color: C.pLight),
                    ),
                  ],
                ),
                const SizedBox(height: 6),
                ClipRRect(
                  borderRadius: BorderRadius.circular(4),
                  child: LinearProgressIndicator(
                    value: (_idx + 1) / _qs.length,
                    minHeight: 5,
                    backgroundColor: C.cardHi,
                    valueColor: const AlwaysStoppedAnimation(C.pLight),
                  ),
                ),
              ],
            ),
          ),
          const SizedBox(height: 10),
          // Q navigator
          SizedBox(
            height: 44,
            child: ListView.builder(
              scrollDirection: Axis.horizontal,
              padding: const EdgeInsets.symmetric(horizontal: 12),
              itemCount: _qs.length,
              itemBuilder: (_, i) {
                Color c;
                if (i == _idx) {
                  c = C.primary;
                } else if (_ans.containsKey(i)) {
                  c = C.ok;
                } else {
                  c = C.cardHi;
                }
                return GestureDetector(
                  onTap: () => setState(() => _idx = i),
                  child: AnimatedContainer(
                    duration: const Duration(milliseconds: 150),
                    width: 36,
