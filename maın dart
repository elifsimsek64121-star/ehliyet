/// Gerçek Google Play Billing akışına bağlı Premium satın alma diyaloğu.
/// "Ücretsiz demo" ile anında açma KALDIRILDI — bu, gerçek parayla
/// satılan bir özelliği bedelsiz vermek anlamına geldiği için Play
/// Store politikalarına aykırıdır. Artık buton doğrudan
/// [BillingManager.buyPremium] üzerinden resmi satın alma akışını
/// başlatır; premium yalnızca Play'den onaylanmış bir satın alma /
/// restore sonrası [AppState.unlockPremium] ile açılır.
class _PremiumDialog extends StatefulWidget {
  final AppState s;
  const _PremiumDialog({required this.s});
  @override
  State<_PremiumDialog> createState() => _PremiumDialogState();
}

class _PremiumDialogState extends State<_PremiumDialog> {
  final BillingManager _billing = BillingManager.instance;
  bool _wasPending = false;

  @override
  void initState() {
    super.initState();
    _billing.addListener(_onBillingChanged);
    _billing.ensureProductLoaded();
  }

  @override
  void dispose() {
    _billing.removeListener(_onBillingChanged);
    super.dispose();
  }

  void _onBillingChanged() {
    if (!mounted) return;
    // Satın alma "pending" durumundan çıkıp premium açıldıysa dialog'u
    // kapatıp kullanıcıyı bilgilendir.
    if (_wasPending && !_billing.purchasePending && widget.s.isPremium) {
      Navigator.of(context).pop();
      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(content: Text('🎉 Premium aktif edildi!')),
      );
      return;
    }
    _wasPending = _billing.purchasePending;
    setState(() {});
  }

  String get _priceLabel {
    final product = _billing.premiumProduct;
    if (product != null) return product.price;
    if (!_billing.storeQueried) return '…';
    return 'Fiyat için mağazaya bağlanılamadı';
  }

  String? get _errorLabel {
    switch (_billing.lastError) {
      case null:
        return null;
      case 'store_unavailable':
        return 'Mağazaya şu anda ulaşılamıyor. Lütfen internet bağlantınızı kontrol edip tekrar deneyin.';
      case 'product_not_found':
        return 'Premium ürünü mağazada bulunamadı. Lütfen daha sonra tekrar deneyin.';
      default:
        return 'Satın alma tamamlanamadı. Lütfen tekrar deneyin.';
    }
  }

  @override
  Widget build(BuildContext context) {
    final isDark = Theme.of(context).brightness == Brightness.dark;
    final err = _errorLabel;
    final canBuy = _billing.available &&
        !_billing.purchasePending &&
        _billing.premiumProduct != null;
    return Dialog(
    backgroundColor: isDark ? const Color(0xFF152238) : C.card,
    shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(24)),
    child: Padding(
      padding: const EdgeInsets.all(28),
      child: Column(
        mainAxisSize: MainAxisSize.min,
        children: [
          const Text('👑', style: TextStyle(fontSize: 60)),
          const SizedBox(height: 12),
          const Text(
            'Sınav365 Premium',
            style: TextStyle(
              color: C.gold,
              fontWeight: FontWeight.w900,
              fontSize: 22,
            ),
          ),
          const SizedBox(height: 4),
          Text(
            _priceLabel,
            style: TextStyle(
              color: isDark ? Colors.white70 : C.txt2,
              fontWeight: FontWeight.w700,
              fontSize: 15,
            ),
          ),
          const SizedBox(height: 16),
          ...[
            '✅ Reklamsız deneyim',
            '✅ Tüm kategoriler (Ceza, Çevre, Motor, Teknik)',
            '✅ Tüm görselli sorular',
            '✅ Süper Zor Mod + sınırsız deneme',
            '✅ Detaylı istatistik ve yanlış analizi',
          ].map(
            (f) => Padding(
              padding: const EdgeInsets.symmetric(vertical: 4),
              child: Text(
                f,
                style: TextStyle(
                  color: Theme.of(context).brightness == Brightness.dark
                      ? const Color(0xFFE8F0FE)
                      : C.txt,
                  fontSize: 14,
                ),
              ),
            ),
          ),
          if (err != null) ...[
            const SizedBox(height: 12),
            Text(
              err,
              textAlign: TextAlign.center,
              style: const TextStyle(color: Colors.redAccent, fontSize: 12.5),
            ),
          ],
          if (!_billing.available && _billing.storeQueried) ...[
            const SizedBox(height: 12),
            Text(
              'Satın alma bu cihazda/ortamda kullanılamıyor (mağaza bağlantısı yok).',
              textAlign: TextAlign.center,
              style: TextStyle(
                color: isDark ? Colors.white54 : C.txt2,
                fontSize: 12.5,
              ),
            ),
          ],
          const SizedBox(height: 24),
          SizedBox(
            width: double.infinity,
            child: ElevatedButton(
              onPressed: canBuy ? () => _billing.buyPremium() : null,
              style: ElevatedButton.styleFrom(
                backgroundColor: C.gold,
                foregroundColor: Colors.black,
                disabledBackgroundColor: C.gold.withOpacity(.4),
                padding: const EdgeInsets.symmetric(vertical: 14),
                shape: RoundedRectangleBorder(
                  borderRadius: BorderRadius.circular(16),
                ),
              ),
              child: _billing.purchasePending
                  ? const SizedBox(
                      height: 18,
                      width: 18,
                      child: CircularProgressIndicator(
                        strokeWidth: 2.4,
                        color: Colors.black,
                      ),
                    )
                  : Text(
                      _billing.premiumProduct != null
                          ? 'PREMIUM\'A GEÇ · ${_billing.premiumProduct!.price}'
                          : 'PREMIUM\'A GEÇ',
                      style: const TextStyle(fontWeight: FontWeight.w900),
                    ),
            ),
          ),
          const SizedBox(height: 8),
          TextButton(
            onPressed: _billing.available && !_billing.purchasePending
                ? () => _billing.restorePurchases()
                : null,
            child: Text(
              'Satın Almaları Geri Yükle',
              style: TextStyle(
                color: isDark ? Colors.white70 : C.txt2,
                fontWeight: FontWeight.w600,
