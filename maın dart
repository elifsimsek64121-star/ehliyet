class _VisualItem {
  final String id;
  final String text;
  final List<String> opts;
  final int correct;
  final String explanation;
  final Cat cat;
  final String? imagePath;
  final Color? accentColor;
  final IconData? accentIcon;
  final String? accentLabel;

  _VisualItem({
    required this.id,
    required this.text,
    required this.opts,
    required this.correct,
    required this.explanation,
    required this.cat,
    this.imagePath,
    this.accentColor,
    this.accentIcon,
    this.accentLabel,
  });

  factory _VisualItem.fromQ(Q q) => _VisualItem(
        id: q.id,
        text: q.text,
        opts: q.opts,
        correct: q.correct,
        explanation: q.explanation,
        cat: q.cat,
        imagePath: q.image,
      );

  factory _VisualItem.fromIcon(VisualQuestion v) => _VisualItem(
        id: v.id,
        text: v.text,
        opts: v.opts,
        correct: v.correct,
        explanation: v.explanation,
        cat: v.cat,
        accentColor: v.visualColor,
        accentIcon: v.visualIcon,
        accentLabel: v.visualLabel,
      );
}

class VisualQuestionsScreen extends StatefulWidget {
  final AppState s;
  const VisualQuestionsScreen({super.key, required this.s});
  @override
  State<VisualQuestionsScreen> createState() => _VisualQuestionsScreenState();
}

class _VisualQuestionsScreenState extends State<VisualQuestionsScreen> {
  int _idx = 0;
  int? _sel;
  bool _answered = false;
  int _correctCount = 0;
  late final List<Q> _imageQs;
  late final List<VisualQuestion> _iconQs;
  late final bool _useRealImages;

  // Hibrit liste: önce gerçek PNG sorular, sonra ikon kartları
  late final List<_VisualItem> _items;

  // Ücretsiz kullanıcıya ilk 8 gerçek görsel soru; kalanı Premium.
  static const int kFreeImageLimit = 8;

  @override
  void initState() {
    super.initState();
    final allImg = List<Q>.from(QB.all.where((q) => q.image != null && q.image!.isNotEmpty));
    allImg.shuffle();
    if (widget.s.isPremium) {
      _imageQs = allImg;
    } else {
      _imageQs = allImg.take(kFreeImageLimit).toList();
    }
    _iconQs = List<VisualQuestion>.from(kVisualQuestions)..shuffle();
    // İkon kartlarının yarısı ücretsiz, yarısı premium
    final iconLimit = widget.s.isPremium ? _iconQs.length : (_iconQs.length / 2).ceil();
    final freeIcons = _iconQs.take(iconLimit).toList();
    _items = [
      ..._imageQs.map((q) => _VisualItem.fromQ(q)),
      ...freeIcons.map((v) => _VisualItem.fromIcon(v)),
    ];
    _useRealImages = false; // legacy flag unused
  }

  int get _total => _items.length;

  void _select(int i) {
    if (_answered) return;
    final cur = _items[_idx];
    final ok = i == cur.correct;
    setState(() {
      _sel = i;
      _answered = true;
      if (ok) _correctCount++;
    });
    widget.s.answer(ok, cur.cat, cur.id);
  }

  void _next() {
    if (_idx < _total - 1) {
      setState(() {
        _idx++;
        _sel = null;
        _answered = false;
      });
    } else {
      Navigator.pop(context);
      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(
          content: Text('Görsel sorular: $_correctCount / $_total doğru'),
        ),
      );
    }
  }

  @override
  Widget build(BuildContext context) {
    final cs = Theme.of(context).colorScheme;
    final isDark = Theme.of(context).brightness == Brightness.dark;

    if (_total == 0) {
      return Scaffold(
        appBar: AppBar(title: const Text('Görsel Sorular')),
        body: const Center(child: Text('Görsel soru bulunamadı.')),
      );
    }

    final curItem = _items[_idx];
    final text = curItem.text;
    final opts = curItem.opts;
    final correct = curItem.correct;
    final explanation = curItem.explanation;
    final imagePath = curItem.imagePath;
    final accentColor = curItem.accentColor;
    final accentIcon = curItem.accentIcon;
    final accentLabel = curItem.accentLabel;

    return Scaffold(
      backgroundColor: isDark ? null : C.bg,
      appBar: AppBar(
        title: Text('Görsel ${_idx + 1}/$_total',
            style: ts(size: 16, w: FontWeight.w700, color: isDark ? Colors.white : C.txt)),
        backgroundColor: isDark ? null : C.surface,
        foregroundColor: isDark ? Colors.white : C.txt,
      ),
      bottomNavigationBar: const BannerAdWidget(),
      body: ListView(
        padding: const EdgeInsets.all(18),
        children: [
          // Gerçek görsel varsa göster, yoksa ikon kartı
          if (imagePath != null)
            QuestionImage(path: imagePath, maxHeight: 280)
          else
            Container(
              height: 180,
              decoration: BoxDecoration(
                gradient: LinearGradient(
                  colors: [
                    (accentColor ?? C.primary).withOpacity(0.15),
                    (accentColor ?? C.primary).withOpacity(0.05),
                  ],
                ),
                borderRadius: BorderRadius.circular(20),
                border: Border.all(color: (accentColor ?? C.primary).withOpacity(0.3)),
              ),
              child: Column(
                mainAxisAlignment: MainAxisAlignment.center,
                children: [
                  Icon(accentIcon ?? Icons.image_rounded, size: 64, color: accentColor ?? C.primary),
                  const SizedBox(height: 10),
                  Container(
                    padding: const EdgeInsets.symmetric(horizontal: 14, vertical: 6),
                    decoration: BoxDecoration(
                      color: accentColor ?? C.primary,
                      borderRadius: BorderRadius.circular(20),
                    ),
                    child: Text(
                      accentLabel ?? 'GÖRSEL',
                      style: const TextStyle(
                        color: Colors.white,
                        fontWeight: FontWeight.w900,
                        letterSpacing: 1,
                      ),
                    ),
                  ),
                ],
              ),
            ),
          const SizedBox(height: 14),
          Text(
            text,
            style: TextStyle(
              fontSize: 17,
              fontWeight: FontWeight.w700,
              color: isDark ? cs.onSurface : C.txt,
              height: 1.45,
            ),
          ),
          const SizedBox(height: 16),
          ...List.generate(opts.length, (i) {
            Color bg = isDark ? (Theme.of(context).cardColor) : Colors.white;
            Color border = isDark ? kBorderDark : const Color(0xFFE2E8F0);
            if (_answered) {
              if (i == correct) {
                bg = C.ok.withOpacity(0.12);
                border = C.okLight;
              } else if (i == _sel) {
                bg = C.err.withOpacity(0.12);
                border = C.errLight;
              }
            }
            return Padding(
              padding: const EdgeInsets.only(bottom: 10),
              child: GestureDetector(
                onTap: () => _select(i),
                child: Container(
                  padding: const EdgeInsets.all(14),
                  decoration: BoxDecoration(
                    color: bg,
                    borderRadius: BorderRadius.circular(14),
                    border: Border.all(color: border, width: 1.5),
                  ),
                  child: Row(
                    children: [
                      Text(
                        String.fromCharCode(65 + i),
                        style: const TextStyle(
                          fontWeight: FontWeight.w900,
                          color: C.primary,
                        ),
                      ),
                      const SizedBox(width: 12),
                      Expanded(
                        child: Text(
                          opts[i],
                          style: TextStyle(
                            color: isDark ? cs.onSurface : C.txt,
                            fontWeight: FontWeight.w500,
                          ),
                        ),
                      ),
                    ],
                  ),
                ),
              ),
            );
          }),
          if (_answered) ...[
            const SizedBox(height: 8),
            Container(
              padding: const EdgeInsets.all(14),
              decoration: BoxDecoration(
                color: C.primary.withOpacity(0.08),
                borderRadius: BorderRadius.circular(14),
              ),
              child: Text(
                explanation,
                style: TextStyle(
                  color: isDark ? cs.onSurface.withOpacity(0.8) : C.txt2,
                  height: 1.4,
                ),
              ),
            ),
            const SizedBox(height: 16),
            SizedBox(
              width: double.infinity,
              child: ElevatedButton(
                onPressed: _next,
                child: Text(_idx < _total - 1 ? 'Sonraki' : 'Bitir'),
              ),
            ),
          ],
        ],
      ),
    );
  }
}

