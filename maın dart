class _TriangleClipper extends CustomClipper<Path> {
  const _TriangleClipper();
  @override
  Path getClip(Size size) => Path()
    ..moveTo(size.width / 2, 0)
    ..lineTo(size.width, size.height)
    ..lineTo(0, size.height)
    ..close();
  @override
  bool shouldReclip(CustomClipper<Path> oldClipper) => false;
}

class _InvertedTriangleClipper extends CustomClipper<Path> {
  const _InvertedTriangleClipper();
  @override
  Path getClip(Size size) => Path()
    ..moveTo(0, 0)
    ..lineTo(size.width, 0)
    ..lineTo(size.width / 2, size.height)
    ..close();
  @override
  bool shouldReclip(CustomClipper<Path> oldClipper) => false;
}

class _DiamondClipper extends CustomClipper<Path> {
  const _DiamondClipper();
  @override
  Path getClip(Size size) => Path()
    ..moveTo(size.width / 2, 0)
    ..lineTo(size.width, size.height / 2)
    ..lineTo(size.width / 2, size.height)
    ..lineTo(0, size.height / 2)
    ..close();
  @override
  bool shouldReclip(CustomClipper<Path> oldClipper) => false;
}

class _OctagonClipper extends CustomClipper<Path> {
  const _OctagonClipper();
  @override
  Path getClip(Size size) {
    final w = size.width, h = size.height;
    final cut = w * 0.29;
    return Path()
      ..moveTo(cut, 0)
      ..lineTo(w - cut, 0)
      ..lineTo(w, cut)
      ..lineTo(w, h - cut)
      ..lineTo(w - cut, h)
      ..lineTo(cut, h)
      ..lineTo(0, h - cut)
      ..lineTo(0, cut)
      ..close();
  }
  @override
  bool shouldReclip(CustomClipper<Path> oldClipper) => false;
}

// ------------------------------------------------------------
//  SECTION: widgets/sign_badge.dart
//  Levhayı gerçek görsel dosyası kullanmadan şekil + renk + ikon
//  ile çizen widget.
//
//  DÜZELTME: Önceki sürümde iç şekil sadece üstten "padding" ile
//  küçültülüyordu; bu da üçgen/eşkenar dörtgen gibi şekillerde
//  çerçevenin eşit kalınlıkta olmamasına (şeklin bozuk görünmesine)
//  yol açıyordu. Artık iç şekil Transform.scale ile TAM ORTADAN
//  küçültülüyor, böylece kenarlıklar her yönde eşit kalınlıkta
//  çiziliyor ve levhalar gerçek trafik levhalarıyla birebir aynı
//  görünüyor.
// ------------------------------------------------------------

class TrafficSignBadge extends StatelessWidget {
  final TrafficSign sign;
  final double size;
  const TrafficSignBadge({super.key, required this.sign, this.size = 96});

  @override
  Widget build(BuildContext context) {
    // Beyaz zeminli levhaların beyaz kartlarda kaybolmasını önlemek için
    // tüm şekillerde belirgin gölge + hafif dış plaka kullanılır.
    switch (sign.shape) {
      case SignShape.triangle:
        return _shaped(
          clipper: const _TriangleClipper(),
          fill: const Color(0xFFFFFBF5), // sıcak beyaz – saf beyaza göre daha görünür
          border: const Color(0xFFE53935),
          iconColor: const Color(0xFF1A1A1A),
          innerScale: 0.76,
          contentShift: size * 0.07,
        );
      case SignShape.invertedTriangle:
        return _shaped(
          clipper: const _InvertedTriangleClipper(),
          fill: const Color(0xFFFFFBF5),
          border: const Color(0xFFE53935),
          iconColor: const Color(0xFF1A1A1A),
          innerScale: 0.76,
          contentShift: -size * 0.07,
        );
      case SignShape.diamondYellow:
        return _shaped(
          clipper: const _DiamondClipper(),
          fill: const Color(0xFFF5B942),
          border: const Color(0xFF1A1A1A),
          iconColor: const Color(0xFF1A1A1A),
          innerScale: 0.78,
        );
      case SignShape.octagon:
        return _shaped(
          clipper: const _OctagonClipper(),
          fill: const Color(0xFFE53935),
          border: Colors.white,
          iconColor: Colors.white,
          innerScale: 0.88,
        );
      case SignShape.circleRed:
        return _circleOrSquare(
          isCircle: true,
          fill: const Color(0xFFFFFBF5),
          border: const Color(0xFFE53935),
          iconColor: const Color(0xFF1A1A1A),
          borderWidth: size * 0.11,
        );
      case SignShape.circleBlue:
        return _circleOrSquare(
          isCircle: true,
          fill: const Color(0xFF1565C0),
          border: Colors.white,
          iconColor: Colors.white,
          borderWidth: size * 0.04,
        );
      case SignShape.squareBlue:
        return _circleOrSquare(
          isCircle: false,
          fill: const Color(0xFF1565C0),
          border: Colors.white,
          iconColor: Colors.white,
          borderWidth: size * 0.04,
        );
    }
  }

  /// Üçgen / ters üçgen / eşkenar dörtgen / sekizgen.
  /// Dış şekil = kenarlık, iç şekil Transform.scale ile ortadan küçültülür.
  /// Ek olarak gölge + hafif dış halka ile beyaz zemin üzerinde net görünür.
  Widget _shaped({
    required CustomClipper<Path> clipper,
    required Color fill,
    required Color border,
    required Color iconColor,
    required double innerScale,
    double contentShift = 0,
  }) {
    return SizedBox(
      width: size,
      height: size,
      child: Stack(
        alignment: Alignment.center,
        clipBehavior: Clip.none,
        children: [
          // Soft drop shadow (dikdörtgen gölge + şekil içinde karartma)
          Positioned.fill(
            child: Transform.translate(
              offset: Offset(0, size * 0.045),
              child: Opacity(
                opacity: 0.22,
                child: ClipPath(
                  clipper: clipper,
                  child: Container(color: Colors.black),
                ),
              ),
            ),
          ),
          // Dış şekil = kenarlık rengi
          ClipPath(
            clipper: clipper,
            child: Container(color: border),
          ),
          // İç dolgu – eşit kalınlıkta çerçeve
          Transform.scale(
            scale: innerScale,
            child: ClipPath(
              clipper: clipper,
              child: Container(
                width: size,
                height: size,
                color: fill,
              ),
            ),
          ),
          // İçerik
          Transform.translate(
            offset: Offset(0, contentShift),
            child: _content(iconColor),
          ),
        ],
      ),
    );
  }

  Widget _circleOrSquare({
    required bool isCircle,
    required Color fill,
    required Color border,
    required Color iconColor,
    required double borderWidth,
  }) {
    // Yasak (kırmızı daire) levhalarında çapraz çizgi: gerçek Türk levhalarına yakın.
    // Hız limiti / overlay metinli ve "giriş yok" (yatay çubuk) hariç.
    final needsSlash = isCircle &&
        border.value == const Color(0xFFE53935).value &&
        sign.overlayText == null &&
        sign.icon != Icons.remove_rounded;

    return Container(
      width: size,
      height: size,
      decoration: BoxDecoration(
        color: fill,
        shape: isCircle ? BoxShape.circle : BoxShape.rectangle,
        borderRadius: isCircle ? null : BorderRadius.circular(size * 0.12),
        border: Border.all(color: border, width: borderWidth),
        boxShadow: [
          BoxShadow(
            color: Colors.black.withOpacity(0.22),
            blurRadius: size * 0.14,
            offset: Offset(0, size * 0.05),
            spreadRadius: -1,
          ),
          BoxShadow(
            color: Colors.black.withOpacity(0.10),
            blurRadius: size * 0.05,
            offset: Offset(0, size * 0.02),
          ),
        ],
      ),
      child: Stack(
        alignment: Alignment.center,
        children: [
          _content(iconColor),
          if (needsSlash)
            CustomPaint(
              size: Size(size, size),
              painter: _ProhibitionSlashPainter(
                color: const Color(0xFFE53935),
                strokeWidth: size * 0.09,
                inset: borderWidth * 0.35,
              ),
            ),
        ],
      ),
    );
  }

  Widget _content(Color iconColor) {
    if (sign.overlayText != null) {
      final text = sign.overlayText!;
      final isLong = text.length > 2;
      // Metin her temada net görünsün: hafif gölge + yüksek kontrast
      return Text(
        text,
        textAlign: TextAlign.center,
        style: TextStyle(
          fontSize: size * (isLong ? 0.24 : 0.38),
          fontWeight: FontWeight.w900,
          color: iconColor,
          letterSpacing: isLong ? -0.6 : -0.4,
          height: 1.0,
          shadows: [
            Shadow(
              color: iconColor.computeLuminance() > 0.5
                  ? Colors.black.withOpacity(0.35)
                  : Colors.white.withOpacity(0.25),
              blurRadius: 2,
              offset: const Offset(0, 1),
            ),
          ],
        ),
      );
    }
    return Icon(sign.icon, size: size * 0.42, color: iconColor);
  }
}

/// Yasak levhası çapraz kırmızı çizgi (sol üst → sağ alt).
class _ProhibitionSlashPainter extends CustomPainter {
  final Color color;
  final double strokeWidth;
  final double inset;
  const _ProhibitionSlashPainter({
    required this.color,
    required this.strokeWidth,
    required this.inset,
  });

  @override
  void paint(Canvas canvas, Size size) {
    final paint = Paint()
      ..color = color
      ..strokeWidth = strokeWidth
      ..strokeCap = StrokeCap.round
      ..style = PaintingStyle.stroke;
    final pad = inset + strokeWidth * 0.4;
    canvas.drawLine(
      Offset(pad, pad),
      Offset(size.width - pad, size.height - pad),
      paint,
    );
  }

  @override
  bool shouldRepaint(covariant _ProhibitionSlashPainter old) =>
      old.color != color || old.strokeWidth != strokeWidth || old.inset != inset;
}

