// ============================================================
//  QUIZ SCREEN  —  Tek motor: Pratik / Deneme / Gerçek Sınav Modu
// ============================================================

enum QuizMode { practice, deneme, real }

class QuizScreen extends StatefulWidget {
  final List<Question> questions;
  final QuizMode mode;
  final String title;
  final String? singleCategory; // pratik modda tek kategori bilgisi

  const QuizScreen({
    super.key,
    required this.questions,
    required this.mode,
    required this.title,
    this.singleCategory,
  });

  @override
  State<QuizScreen> createState() => _QuizScreenState();
}

class _QuizScreenState extends State<QuizScreen> {
  int _index = 0;
  int? _selected;
  bool _answered = false;
  final Map<int, int> _answers = {}; // question index -> selected option index (-1 = boş)
  Timer? _timer;
  int _remainingSeconds = 0;
  bool _finishing = false;

  bool get _immediateFeedback => widget.mode == QuizMode.practice;
  bool get _isTimed => widget.mode != QuizMode.practice;

  @override
  void initState() {
    super.initState();
    if (_isTimed) {
      _remainingSeconds = widget.mode == QuizMode.real
          ? kExamDurationSeconds
          : (widget.questions.length * 60); // deneme: soru başına 1 dk
      _timer = Timer.periodic(const Duration(seconds: 1), (t) {
        if (!mounted) return;
        setState(() => _remainingSeconds--);
        if (_remainingSeconds <= 0) {
          t.cancel();
          _finish(auto: true);
        }
      });
    }
  }

  @override
  void dispose() {
    _timer?.cancel();
    super.dispose();
  }

  Question get _current => widget.questions[_index];

  void _selectOption(int optionIndex) {
    if (_answered && _immediateFeedback) return;
    HapticFeedback.selectionClick();
    setState(() {
      _selected = optionIndex;
      if (_immediateFeedback) _answered = true;
    });
    if (_immediateFeedback) {
      HapticFeedback.lightImpact();
    }
  }

  void _next() {
    _answers[_index] = _selected ?? -1;
    if (_index >= widget.questions.length - 1) {
      _finish();
      return;
    }
    setState(() {
      _index++;
      _selected = _answers[_index];
      _answered = _immediateFeedback && _answers.containsKey(_index);
    });
  }

  void _prev() {
    if (_index == 0) return;
    _answers[_index] = _selected ?? -1;
    setState(() {
      _index--;
      _selected = _answers[_index];
      _answered = _immediateFeedback && _answers.containsKey(_index);
    });
  }

  Future<void> _finish({bool auto = false}) async {
    if (_finishing) return;
    _finishing = true;
    _timer?.cancel();
    _answers[_index] = _selected ?? _answers[_index] ?? -1;

    int correct = 0, wrong = 0, empty = 0;
    final correctByCat = <String, int>{};
    final totalByCat = <String, int>{};

    for (int i = 0; i < widget.questions.length; i++) {
      final q = widget.questions[i];
      final ans = _answers[i] ?? -1;
      totalByCat[q.category] = (totalByCat[q.category] ?? 0) + 1;
      if (ans == -1) {
        empty++;
      } else if (ans == q.correctIndex) {
        correct++;
        correctByCat[q.category] = (correctByCat[q.category] ?? 0) + 1;
        await AppState.markCorrectRemovesWrong(q.id);
        await AppState.addCategoryResult(q.category, correct: true);
      } else {
        wrong++;
        await AppState.markWrong(q.id);
        await AppState.addCategoryResult(q.category, correct: false);
      }
    }

    final total = widget.questions.length;
    final scoreOn100 = total == 0 ? 0.0 : (correct / total) * 100.0;
    final passed = widget.mode == QuizMode.practice ? scoreOn100 >= 70 : scoreOn100 >= kExamPassScore;

    final attempt = ExamAttempt(
      id: DateTime.now().microsecondsSinceEpoch.toString(),
      date: DateTime.now(),
      mode: widget.mode == QuizMode.practice
          ? 'practice'
          : widget.mode == QuizMode.deneme
              ? 'deneme'
              : 'real',
      category: widget.singleCategory,
      totalQuestions: total,
      correct: correct,
      wrong: wrong,
      empty: empty,
      scoreOn100: scoreOn100,
      passed: passed,
      correctByCategory: correctByCat,
      totalByCategory: totalByCat,
    );
    await AppState.saveAttempt(attempt);

    if (!mounted) return;
    AdManager.tryShowInterstitial(
      every: 3,
      onDone: () {
        if (!mounted) return;
        Navigator.of(context).pushReplacement(MaterialPageRoute(
          builder: (_) => ResultScreen(attempt: attempt, questions: widget.questions, answers: Map.of(_answers)),
        ));
      },
    );
  }

  String _fmtTime(int s) {
    if (s < 0) s = 0;
    final m = s ~/ 60;
    final sec = s % 60;
    return '${m.toString().padLeft(2, '0')}:${sec.toString().padLeft(2, '0')}';
  }

  @override
  Widget build(BuildContext context) {
    final isDark = Theme.of(context).brightness == Brightness.dark;

    // Savunmacı kontrol: soru listesi boşsa (örn. bir kategoride hiç soru
    // kalmamışsa) çökmek yerine bilgilendirici bir ekran gösterilir.
    if (widget.questions.isEmpty) {
      return Scaffold(
        backgroundColor: isDark ? kSurface : const Color(0xFFF4F5F8),
        appBar: AppBar(
          title: Text(widget.title, style: ts(size: 15, w: FontWeight.w700, color: Colors.white)),
          backgroundColor: kCardElevated,
          foregroundColor: Colors.white,
          elevation: 0,
        ),
        body: Center(
          child: Padding(
            padding: const EdgeInsets.all(24),
            child: Column(mainAxisSize: MainAxisSize.min, children: [
              Icon(Icons.inbox_rounded, size: 48, color: isDark ? Colors.white24 : Colors.black26),
              const SizedBox(height: 14),
              Text('Bu sette gösterilecek soru bulunamadı.',
                  textAlign: TextAlign.center,
                  style: ts(size: 14, w: FontWeight.w600, color: isDark ? Colors.white70 : Colors.black54)),
            ]),
          ),
        ),
      );
    }

    final q = _current;
    final progress = (_index + 1) / widget.questions.length;
    final timeCritical = _isTimed && _remainingSeconds <= 60;

    return PopScope(
      canPop: !_isTimed,
      onPopInvokedWithResult: (didPop, result) async {
        if (didPop || !_isTimed) return;
        final leave = await showDialog<bool>(
          context: context,
          builder: (_) => AlertDialog(
            title: const Text('Sınavdan Çık?'),
            content: const Text('Sınavı yarıda bırakırsanız ilerlemeniz kaydedilmez.'),
            actions: [
              TextButton(onPressed: () => Navigator.pop(context, false), child: const Text('Devam Et')),
              TextButton(
                  onPressed: () => Navigator.pop(context, true),
                  child: const Text('Çık', style: TextStyle(color: kDanger))),
            ],
          ),
        );
        if (leave == true && context.mounted) Navigator.of(context).pop();
      },
      child: Scaffold(
        backgroundColor: isDark ? kSurface : const Color(0xFFF4F5F8),
        appBar: AppBar(
          title: Text(widget.title, style: ts(size: 15, w: FontWeight.w700, color: Colors.white)),
          backgroundColor: kCardElevated,
          foregroundColor: Colors.white,
          elevation: 0,
          actions: [
            if (_isTimed)
              Padding(
                padding: const EdgeInsets.only(right: 14),
                child: Center(
                  child: Container(
                    padding: const EdgeInsets.symmetric(horizontal: 10, vertical: 5),
                    decoration: BoxDecoration(
                      color: timeCritical ? kDanger.withAlpha(40) : const Color(0x22C9A24B),
                      borderRadius: BorderRadius.circular(10),
                    ),
                    child: Row(children: [
                      Icon(Icons.timer_rounded, size: 15, color: timeCritical ? kDanger : kPrimarySoft),
                      const SizedBox(width: 5),
                      Text(_fmtTime(_remainingSeconds),
                          style: ts(size: 13, w: FontWeight.w800, color: timeCritical ? kDanger : kPrimarySoft)),
                    ]),
                  ),
                ),
              ),
          ],
        ),
        body: Column(children: [
          ClipRRect(
            child: TweenAnimationBuilder<double>(
              tween: Tween(begin: 0, end: progress),
              duration: const Duration(milliseconds: 280),
              curve: Curves.easeOutCubic,
              builder: (_, value, __) => LinearProgressIndicator(
                value: value,
                minHeight: 4,
                backgroundColor: isDark ? kCardElevated : const Color(0xFFE8EAED),
                valueColor: const AlwaysStoppedAnimation<Color>(kPrimary),
              ),
            ),
          ),
          Expanded(
            child: AnimatedSwitcher(
              duration: const Duration(milliseconds: 260),
              switchInCurve: Curves.easeOutCubic,
              switchOutCurve: Curves.easeInCubic,
              transitionBuilder: (child, animation) {
                final slide = Tween<Offset>(begin: const Offset(0.06, 0), end: Offset.zero)
                    .animate(animation);
                return FadeTransition(
                  opacity: animation,
                  child: SlideTransition(position: slide, child: child),
                );
              },
              child: ListView(
                key: ValueKey('${widget.title}_$_index'),
                padding: const EdgeInsets.all(16),
                children: [
                  Row(children: [
                    Container(
                      padding: const EdgeInsets.symmetric(horizontal: 10, vertical: 4),
                      decoration:
                          BoxDecoration(color: kNavyAccent.withAlpha(60), borderRadius: BorderRadius.circular(8)),
                      child: Text(kCategoryTitles[q.category] ?? q.category,
                          style: ts(size: 11, w: FontWeight.w700, color: kPrimarySoft)),
                    ),
                    const Spacer(),
                    Text('${_index + 1} / ${widget.questions.length}',
                        style: ts(size: 12, color: isDark ? Colors.white54 : Colors.black45)),
                  ]),
                  const SizedBox(height: 14),
                  Container(
                    padding: const EdgeInsets.all(16),
                    decoration: BoxDecoration(
                      color: isDark ? kCard : Colors.white,
                      borderRadius: BorderRadius.circular(16),
                      border: Border.all(color: isDark ? kBorder : const Color(0xFFE4E6EC)),
                    ),
                    child: Text(q.text, style: ts(size: 16, w: FontWeight.w700, color: isDark ? Colors.white : Colors.black87, height: 1.4)),
                  ),
                  const SizedBox(height: 16),
                  ...List.generate(q.options.length, (i) {
                    final label = String.fromCharCode(65 + i); // A, B, C, D
                    OptionState state = OptionState.idle;
                    if (_immediateFeedback && _answered) {
                      if (i == q.correctIndex) {
                        state = OptionState.correct;
                      } else if (i == _selected) {
                        state = OptionState.wrong;
                      }
                    } else if (_selected == i) {
                      state = OptionState.selected;
                    }
                    return OptionTile(
                      label: label,
                      text: q.options[i],
                      state: state,
                      isDark: isDark,
                      onTap: () => _selectOption(i),
                    );
                  }),
                  if (_immediateFeedback && _answered && q.explanation != null) Container(
                    margin: const EdgeInsets.only(top: 4),
                    padding: const EdgeInsets.all(12),
                    decoration: BoxDecoration(
                      color: const Color(0x222B4C8C),
                      borderRadius: BorderRadius.circular(10),
                    ),
                    child: Row(crossAxisAlignment: CrossAxisAlignment.start, children: [
                      const Icon(Icons.lightbulb_rounded, color: kNavyAccent, size: 18),
                      const SizedBox(width: 8),
                      Expanded(child: Text(q.explanation!, style: ts(size: 12.5, color: isDark ? Colors.white70 : Colors.black87, height: 1.35))),
                    ]),
                  ),
                ],
              ),
            ),
          ),
          Container(
            padding: const EdgeInsets.fromLTRB(14, 10, 14, 14),
            decoration: BoxDecoration(
              color: isDark ? kCard : Colors.white,
              border: Border(top: BorderSide(color: isDark ? kBorder : const Color(0xFFE4E6EC))),
            ),
            child: Row(children: [
              if (_index > 0) IconButton(
                onPressed: _prev,
                icon: Icon(Icons.chevron_left_rounded, color: isDark ? Colors.white70 : Colors.black54),
                style: IconButton.styleFrom(
                  backgroundColor: isDark ? kCardElevated : const Color(0xFFF4F5F8),
                  shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(12)),
                ),
              ),
              if (_index > 0) const SizedBox(width: 8),
              if (_isTimed && _selected == null && !_answers.containsKey(_index)) ...[
                Expanded(
                  child: OutlinedButton(
                    onPressed: _next,
                    style: OutlinedButton.styleFrom(
                      padding: const EdgeInsets.symmetric(vertical: 15),
                      side: BorderSide(color: isDark ? kBorder : const Color(0xFFE4E6EC)),
                      shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(12)),
                    ),
                    child: Text('BOŞ GEÇ', style: ts(size: 13.5, w: FontWeight.w700, color: isDark ? Colors.white54 : Colors.black45)),
                  ),
                ),
                const SizedBox(width: 8),
              ],
              Expanded(
                flex: 2,
                child: ElevatedButton.icon(
                  onPressed: (_selected != null || _answers.containsKey(_index)) ? _next : null,
                  icon: Icon(_index >= widget.questions.length - 1 ? Icons.flag_rounded : Icons.arrow_forward_rounded),
                  label: Text(_index >= widget.questions.length - 1 ? 'BİTİR' : 'SONRAKİ SORU',
                      style: ts(size: 14.5, w: FontWeight.w800, color: kSurface)),
                ),
              ),
            ]),
          ),
        ]),
      ),
    );
  }
}

