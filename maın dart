class WeakestTopicsCard extends StatelessWidget {
  final AppState s;
  const WeakestTopicsCard({super.key, required this.s});

  @override
  Widget build(BuildContext context) {
    final entries = Cat.values.map((c) {
      final total = QB.byCat(c).length;
      final done = s.catScores[c] ?? 0;
      final pct = total == 0 ? 0.0 : done / total;
      return (c, pct);
    }).toList()
      ..sort((a, b) => a.$2.compareTo(b.$2));
    final weakest = entries.take(3).toList();

    return Container(
      padding: const EdgeInsets.all(18),
      decoration: BoxDecoration(
        color: C.card,
        borderRadius: BorderRadius.circular(20),
