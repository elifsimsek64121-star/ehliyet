// ============================================================
//  WRONG ANSWERS SCREEN  —  Yanlışlarım: geçmişte hatalı cevaplanan
//  sorular. Kullanıcı bu sorulardan tekrar pratik yapabilir.
// ============================================================

class WrongAnswersScreen extends StatefulWidget {
  const WrongAnswersScreen({super.key});
  @override
  State<WrongAnswersScreen> createState() => _WrongAnswersScreenState();
}

class _WrongAnswersScreenState extends State<WrongAnswersScreen> {
  List<Question> _wrong = [];

  @override
  void initState() {
    super.initState();
    _load();
  }

  void _load() {
    final ids = AppState.loadWrongIds();
    setState(() {
      _wrong = ids.map((id) => QuestionBank.byId(id)).whereType<Question>().toList();
    });
  }

  void _removeOne(Question q) {
    final removed = q;
    final idx = _wrong.indexOf(q);
    setState(() => _wrong.removeWhere((w) => w.id == q.id));
    AppState.removeWrongId(q.id);
    ScaffoldMessenger.of(context).showSnackBar(SnackBar(
      content: const Text('Sorunuz listeden kaldırıldı.'),
      action: SnackBarAction(
        label: 'GERİ AL',
        onPressed: () {
          AppState.markWrong(removed.id);
          setState(() {
            if (idx >= 0 && idx <= _wrong.length) {
              _wrong.insert(idx, removed);
            } else {
              _wrong.add(removed);
            }
          });
        },
      ),
      duration: const Duration(seconds: 3),
    ));
  }

  void _practiceAll() {
    if (_wrong.isEmpty) return;
    AdManager.tryShowInterstitial(
      every: 3,
      onDone: () {
        if (!mounted) return;
        Navigator.of(context)
            .push(MaterialPageRoute(
              builder: (_) => QuizScreen(
                questions: List.of(_wrong)..shuffle(),
                mode: QuizMode.practice,
                title: 'Yanlışlarım Tekrarı',
              ),
            ))
            .then((_) => _load());
      },
    );
  }

  @override
  Widget build(BuildContext context) {
    final isDark = Theme.of(context).brightness == Brightness.dark;

    return Scaffold(
      backgroundColor: isDark ? kSurface : const Color(0xFFF4F5F8),
      appBar: AppBar(
        title: Text('Yanlışlarım (${_wrong.length})', style: ts(size: 16, w: FontWeight.w700, color: Colors.white)),
        backgroundColor: kCardElevated,
        foregroundColor: Colors.white,
        elevation: 0,
      ),
      bottomNavigationBar: const BannerAdWidget(),
      body: _wrong.isEmpty
          ? Center(
              child: Column(mainAxisAlignment: MainAxisAlignment.center, children: [
                Icon(Icons.emoji_events_rounded, size: 64, color: isDark ? Colors.white24 : Colors.black26),
                const SizedBox(height: 16),
                Text('Hiç yanlışın yok! 🎉', style: ts(size: 16, w: FontWeight.w700, color: isDark ? Colors.white54 : Colors.black45)),
                const SizedBox(height: 6),
                Text('Deneme çözdükçe yanlışların burada listelenir.',
                    style: ts(size: 12.5, color: isDark ? Colors.white38 : Colors.black38)),
              ]),
            )
          : Column(children: [
              Padding(
                padding: const EdgeInsets.fromLTRB(14, 14, 14, 4),
                child: ElevatedButton.icon(
                  onPressed: _practiceAll,
                  icon: const Icon(Icons.refresh_rounded),
                  label: Text('TÜM YANLIŞLARI TEKRAR ÇÖZ (${_wrong.length})', style: ts(size: 13.5, w: FontWeight.w800, color: kSurface)),
                ),
              ),
              Padding(
                padding: const EdgeInsets.fromLTRB(14, 4, 14, 8),
                child: Text('Bir soruyu listeden çıkarmak için sola kaydırın.',
                    style: ts(size: 11.5, color: isDark ? Colors.white38 : Colors.black38)),
              ),
              Expanded(
                child: ListView.builder(
                  padding: const EdgeInsets.all(14),
                  itemCount: _wrong.length,
                  itemBuilder: (_, i) {
                    final q = _wrong[i];
                    return Dismissible(
                      key: ValueKey(q.id),
                      direction: DismissDirection.endToStart,
                      background: Container(
                        margin: const EdgeInsets.only(bottom: 8),
                        alignment: Alignment.centerRight,
                        padding: const EdgeInsets.symmetric(horizontal: 18),
                        decoration: BoxDecoration(color: kDanger.withAlpha(50), borderRadius: BorderRadius.circular(12)),
                        child: const Icon(Icons.delete_rounded, color: kDanger),
                      ),
                      onDismissed: (_) => _removeOne(q),
                      child: Container(
                        margin: const EdgeInsets.only(bottom: 8),
                        padding: const EdgeInsets.all(12),
                        decoration: BoxDecoration(
                          color: isDark ? kCard : Colors.white,
                          borderRadius: BorderRadius.circular(12),
                          border: Border.all(color: isDark ? kBorder : const Color(0xFFE4E6EC)),
                        ),
                        child: Row(children: [
                          Container(
                            padding: const EdgeInsets.symmetric(horizontal: 8, vertical: 3),
                            decoration: BoxDecoration(color: kDanger.withAlpha(30), borderRadius: BorderRadius.circular(8)),
                            child: Text(kCategoryTitles[q.category] ?? q.category, style: ts(size: 10.5, w: FontWeight.w700, color: kDanger)),
                          ),
                          const SizedBox(width: 10),
                          Expanded(child: Text(q.text, style: ts(size: 13, w: FontWeight.w600, color: isDark ? Colors.white : Colors.black87), maxLines: 2, overflow: TextOverflow.ellipsis)),
                          Icon(Icons.swipe_left_rounded, size: 15, color: isDark ? Colors.white24 : Colors.black26),
                        ]),
                      ),
                    );
                  },
                ),
              ),
            ]),
    );
  }
}

